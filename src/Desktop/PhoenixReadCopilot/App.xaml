<?xml version="1.0" encoding="utf-8" ?>
<Application x:Class="PhoenixReadCopilot.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PhoenixReadCopilot">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/>
                <ResourceDictionary Source="ms-appx:///Styles/Overrides.xaml"/>
                <ResourceDictionary Source="ms-appx:///Styles/ItemsRepeaterItemStyle.xaml"/>
                <ResourceDictionary Source="ms-appx:///Styles/TitleBar.xaml"/>
                <ResourceDictionary Source="ms-appx:///Styles/SelectorBar.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/Core/Player/PlayerResources.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/Home/HeaderTile.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/Components/ShimmerLayout/ShimmerLayout.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/Components/CoverImage/CoverImage.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/Components/IconTextBlock/IconTextBlock.xaml"/>
                <ResourceDictionary Source="ms-appx:///Controls/Components/NavigationView/NavigationView.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="WindowNarrowMinWidth">850</x:Double>

            <UniformGridLayout x:Key="VideoLayout"
                               ItemsStretch="Fill"
                               MinColumnSpacing="4"
                               MinItemHeight="370"
                               MinItemWidth="200"
                               MinRowSpacing="10"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
