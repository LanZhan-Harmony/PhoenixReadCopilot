<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Player.VideoRecommendSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:PhoenixReadCopilot.Controls.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:essential="using:WinUI3Package"
             xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
             xmlns:local="using:PhoenixReadCopilot.Controls.Player"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:PhoenixReadCopilot.Strings"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:PlayerRecommendedDramaItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel">
            <ScrollView x:Name="VideoScrollView" Style="{StaticResource PageScrollViewStyle}">
                <ItemsRepeater x:Name="VideoRepeater"
                               Margin="12"
                               ElementClearing="VideoRepeater_ElementClearing"
                               ElementPrepared="VideoRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource PlayerRecommendedDramaItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout ItemsStretch="Fill"
                                           MinColumnSpacing="4"
                                           MinItemHeight="260"
                                           MinItemWidth="130"
                                           MinRowSpacing="4"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollView>
        </essential:RevealFocusPanel>
        <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</UserControl>
