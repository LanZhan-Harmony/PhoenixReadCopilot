<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="PhoenixReadCopilot.Controls.Player.PlayerRecommendedVideoItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:cvt="using:PhoenixReadCopilot.Converters"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                    xmlns:strings="using:PhoenixReadCopilot.Strings">

    <DataTemplate x:Key="PlayerRecommendedVideoItemTemplate" x:DataType="items:DramaItemViewModel">
        <Button Command="{x:Bind PlayCommand}"
                DataContext="{x:Bind}"
                Style="{StaticResource GridRepeaterItemStyle}">
            <Button.ContextFlyout>
                <MenuFlyout ShouldConstrainToRootBounds="False">
                    <MenuFlyoutItem Command="{x:Bind OpenInNewWindowCommand}" Text="{x:Bind strings:Resources.OpenInNewWindow}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="WindowPlay"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind AddToViewLaterCommand}" Text="{x:Bind strings:Resources.AddToViewLater}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="CalendarAdd"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind PinCommand}" Text="{x:Bind strings:Resources.FixContent}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="Pin"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <Grid x:Name="TemplateContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="65"/>
                </Grid.RowDefinitions>

                <!--  海报封面容器  -->
                <components:CoverImage x:Name="CoverImage"
                                       Grid.Row="0"
                                       Margin="4"
                                       CornerRadius="5"
                                       Source="{x:Bind Cover}"/>

                <!--  信息与元数据  -->
                <Grid Grid.Row="1"
                      Padding="6,0,6,6"
                      RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Left"
                               FontSize="13"
                               FontWeight="SemiBold"
                               MaxLines="2"
                               Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"/>

                    <!--  底部行：题材分类 / 热度播放量  -->
                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--  标签  -->
                        <components:IconTextBlock Grid.Column="0"
                                                  IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Symbol="Tag"
                                                  Text="{x:Bind Category}"
                                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind cvt:Converter.StringToVisibility(Category)}"/>

                        <!--  热度或播放量  -->
                        <components:IconTextBlock Grid.Column="1"
                                                  IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Symbol="PlayCircle"
                                                  Text="{x:Bind HeatOrPlayCountText}"
                                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                  ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"
                                                  Visibility="{x:Bind cvt:Converter.StringToVisibility(HeatOrPlayCountText)}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
