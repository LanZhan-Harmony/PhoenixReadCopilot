<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Player.FavoriteButton"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:cvt="using:PhoenixReadCopilot.Converters"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:essential="using:WinUI3Package"
                            xmlns:ic="using:FluentIcons.WinUI"
                            xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                            xmlns:local="using:PhoenixReadCopilot.Controls.Player"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:strings="using:PhoenixReadCopilot.Strings"
                            mc:Ignorable="d">

    <StackPanel Spacing="8">
        <ToggleButton x:Name="Btn"
                      Width="48"
                      Height="48"
                      Padding="0"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Command="{x:Bind Command, Mode=OneWay}"
                      CornerRadius="24"
                      IsChecked="{x:Bind IsFavorited, Mode=OneWay}"
                      ToolTipService.ToolTip="{x:Bind strings:Resources.Favorite}">
            <ic:SymbolIcon FontSize="16"
                           IconVariant="{x:Bind cvt:Converter.BoolToIconVariant(IsFavorited), Mode=OneWay}"
                           Symbol="Star"/>
        </ToggleButton>
        <TextBlock HorizontalAlignment="Center"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="{x:Bind Tip, Mode=OneWay}"/>
    </StackPanel>
</UserControl>
