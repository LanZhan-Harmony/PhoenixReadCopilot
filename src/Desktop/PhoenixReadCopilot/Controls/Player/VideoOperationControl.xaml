<?xml version="1.0" encoding="utf-8" ?>
<local:VideoPlayerPageControlBase x:Class="PhoenixReadCopilot.Controls.Player.VideoOperationControl"
                                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                  xmlns:constants="using:PhoenixReadCopilot.Core.Enums"
                                  xmlns:converters="using:PhoenixReadCopilot.Converters"
                                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                  xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                                  xmlns:local="using:PhoenixReadCopilot.Controls.Player"
                                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                  xmlns:strings="using:PhoenixReadCopilot.Strings"
                                  mc:Ignorable="d">

    <UserControl.Resources>
        <converters:LoopTypeConverter x:Key="LoopTypeConverter"/>
    </UserControl.Resources>

    <StackPanel Spacing="20">
        <StackPanel Orientation="Horizontal" Spacing="16">
            <local:LikeButton Command="{x:Bind ViewModel.ToggleLikeCommand, Mode=OneWay}"
                              IsLiked="{x:Bind ViewModel.IsLiked, Mode=OneWay}"
                              Tip="{x:Bind ViewModel.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
            <local:FavoriteButton Command="{x:Bind ViewModel.ToggleFavoriteCommand, Mode=OneWay}"
                                  IsFavorited="{x:Bind ViewModel.IsFavorited, Mode=OneWay}"
                                  Tip="{x:Bind ViewModel.FavoriteCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
            <local:ShareButton Command="{x:Bind ViewModel.ShareCommand, Mode=OneWay}"/>
        </StackPanel>

        <!--  制作名单  -->
        <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.Credits, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
            <TextBlock FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="制作名单"/>
            <ListView ItemsSource="{x:Bind ViewModel.Credits, Mode=OneWay}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="items:DramaCreditItemViewModel">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="40"
                                           Height="40"
                                           DisplayName="{x:Bind Name, Mode=OneWay}"
                                           ProfilePicture="{x:Bind Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind RoleText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Padding="16,4"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ToggleFollowCommand, Mode=OneWay}"
                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ComboBox x:Name="LoopComboBox"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.LoopTypes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentLoop, Mode=OneWay}"
                      SelectionChanged="OnLoopSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="constants:VideoLoopType">
                        <TextBlock Text="{x:Bind Converter={StaticResource LoopTypeConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <local:DownloadButton ViewModel="{x:Bind ViewModel.Downloader, Mode=OneWay}"/>
        </StackPanel>
    </StackPanel>
</local:VideoPlayerPageControlBase>
