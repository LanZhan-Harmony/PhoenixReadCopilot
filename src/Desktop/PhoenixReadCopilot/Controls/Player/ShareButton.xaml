<?xml version="1.0" encoding="utf-8" ?>
<base:LayoutUserControlBase
    x:Class="PhoenixReadCopilot.Controls.Player.ShareButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:PhoenixReadCopilot.Strings"
    mc:Ignorable="d">

    <StackPanel Spacing="8">
        <Button
            x:Name="Btn"
            Width="48"
            Height="48"
            Padding="0"
            HorizontalAlignment="Center"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Command="{x:Bind Command, Mode=OneWay}"
            CornerRadius="24"
            ToolTipService.ToolTip="{x:Bind strings:Resources.Share}">
            <ic:SymbolIcon FontSize="16" Symbol="Share"/>
        </Button>
        <TextBlock
            HorizontalAlignment="Center"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind strings:Resources.Share}"/>
    </StackPanel>
</base:LayoutUserControlBase>
