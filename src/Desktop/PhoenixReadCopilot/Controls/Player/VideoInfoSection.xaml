<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Player.VideoInfoSection"
                                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                  xmlns:community="using:CommunityToolkit.WinUI.Controls"
                                  xmlns:constants="using:PhoenixReadCopilot.Core.Enums"
                                  xmlns:converters="using:PhoenixReadCopilot.Converters"
                                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                  xmlns:essential="using:WinUI3Package"
                                  xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                                  xmlns:local="using:PhoenixReadCopilot.Controls.Player"
                                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                  mc:Ignorable="d">

    <UserControl.Resources>
        <converters:LoopTypeConverter x:Key="LoopTypeConverter"/>
    </UserControl.Resources>

    <ScrollView Style="{StaticResource PageScrollViewStyle}">
        <StackPanel Margin="16,12" Spacing="12">
            <local:VideoStatControl Margin="8,0,0,8" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

            <!--  Tag  -->
            <ItemsRepeater x:Name="TagRepeater" ItemsSource="{x:Bind ViewModel.Tags, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Padding="6,4"
                                AutomationProperties.Name="{x:Bind}"
                                Background="Transparent"
                                Click="OnTagButtonClick"
                                Content="{x:Bind}"
                                DataContext="{x:Bind}"
                                FontSize="12"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <community:WrapLayout HorizontalSpacing="8" VerticalSpacing="8"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <!--  简介  -->
            <TextBlock Margin="4,6,4,0"
                       IsTextSelectionEnabled="True"
                       LineHeight="28"
                       Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                       TextWrapping="Wrap"/>

            <!--  操作按钮  -->
            <StackPanel Orientation="Horizontal" Spacing="16">
                <local:LikeButton Command="{x:Bind ViewModel.ToggleLikeCommand}"
                                  IsLiked="{x:Bind ViewModel.IsLiked, Mode=OneWay}"
                                  Tip="{x:Bind ViewModel.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
                <local:FavoriteButton Command="{x:Bind ViewModel.ToggleFavoriteCommand}"
                                      IsFavorited="{x:Bind ViewModel.IsFavorited, Mode=OneWay}"
                                      Tip="{x:Bind ViewModel.FavoriteCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
                <local:ShareButton Command="{x:Bind ViewModel.ShareCommand}"/>
            </StackPanel>

            <!--  循环播放按钮  -->
            <ComboBox x:Name="LoopComboBox"
                      HorizontalAlignment="Stretch"
                      essential:ComboBoxHelper.AcrylicWorkaround="True"
                      ItemsSource="{x:Bind ViewModel.LoopTypes, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.CurrentLoop, Mode=OneWay}"
                      SelectionChanged="OnLoopSelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="constants:VideoLoopType">
                        <TextBlock Text="{x:Bind Converter={StaticResource LoopTypeConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!--  下载按钮  -->
            <local:DownloadButton ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

            <!--  演职人员  -->
            <TextBlock Margin="0,10,0,0"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="演职人员"
                       Visibility="{x:Bind ViewModel.Credits, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
            <ListView IsItemClickEnabled="True"
                      ItemClick="OnCreditItemClick"
                      ItemsSource="{x:Bind ViewModel.Credits, Mode=OneWay}"
                      SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="items:DramaCreditItemViewModel">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PersonPicture Width="40"
                                           Height="40"
                                           DisplayName="{x:Bind Name, Mode=OneWay}"
                                           ProfilePicture="{x:Bind Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{x:Bind Name, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind RoleText, Mode=OneWay}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Padding="16,4"
                                    VerticalAlignment="Center"
                                    Command="{x:Bind ToggleFollowCommand, Mode=OneWay}"
                                    Content="{x:Bind FollowButtonText, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollView>
</UserControl>
