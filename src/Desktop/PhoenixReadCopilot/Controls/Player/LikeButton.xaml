<?xml version="1.0" encoding="utf-8" ?>
<base:LayoutUserControlBase x:Class="PhoenixReadCopilot.Controls.Player.LikeButton"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:base="using:WinUIKernel.Share.Base"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:ic="using:FluentIcons.WinUI"
                            xmlns:local="using:PhoenixReadCopilot.Controls.Player"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:strings="using:PhoenixReadCopilot.Strings"
                            mc:Ignorable="d">

    <Grid>
        <StackPanel Spacing="8">
            <ToggleButton x:Name="Btn"
                          Width="48"
                          Height="48"
                          Padding="0"
                          HorizontalAlignment="Center"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Command="{x:Bind Command, Mode=OneWay}"
                          CornerRadius="24"
                          IsChecked="{x:Bind IsLiked, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind strings:Resources.Like}">
                <ic:SymbolIcon FontSize="16"
                               IconVariant="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToIconVariantConverter}}"
                               Symbol="ThumbLike"/>
            </ToggleButton>
            <TextBlock HorizontalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind Tip, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</base:LayoutUserControlBase>
