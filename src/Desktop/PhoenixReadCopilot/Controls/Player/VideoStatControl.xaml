<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Player.VideoStatControl"
                                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                  xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                                  xmlns:cvt="using:PhoenixReadCopilot.Converters"
                                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                  xmlns:local="using:PhoenixReadCopilot.Controls.Player"
                                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                  xmlns:strings="using:PhoenixReadCopilot.Strings"
                                  mc:Ignorable="d">

    <StackPanel Orientation="Horizontal" Spacing="12">
        <components:IconTextBlock VerticalAlignment="Center"
                                  IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                  Symbol="PlayCircle"
                                  Text="{x:Bind cvt:Converter.DoubleCountToText(ViewModel.PlayCount), Mode=OneWay}"
                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                  ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"/>
        <components:IconTextBlock VerticalAlignment="Center"
                                  IconBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                  Symbol="Comment"
                                  Text="{x:Bind cvt:Converter.DoubleCountToText(ViewModel.CommentCount), Mode=OneWay}"
                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                  ToolTipService.ToolTip="{x:Bind strings:Resources.ReplyCount}"/>
        <components:IconTextBlock VerticalAlignment="Center"
                                  IconBrush="{ThemeResource TextFillColorSecondaryBrush}"
                                  Symbol="Fire"
                                  Text="{x:Bind ViewModel.OnlineCountText, Mode=OneWay}"
                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"/>
    </StackPanel>
</UserControl>
