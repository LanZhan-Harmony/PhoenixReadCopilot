<?xml version="1.0" encoding="utf-8" ?>
<local:DramaReviewMainPanelBase x:Class="PhoenixReadCopilot.Controls.Comment.DramaReviewMainPanel"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:api="using:PhoenixReadApi"
                                xmlns:base="using:WinUIKernel.Share.Base"
                                xmlns:comp="using:PhoenixReadCopilot.Controls.Components"
                                xmlns:converters="using:PhoenixReadCopilot.Converters"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:ic="using:FluentIcons.WinUI"
                                xmlns:items="using:PhoenixReadCopilot.ViewModels.Components"
                                xmlns:local="using:PhoenixReadCopilot.Controls.Comment"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                xmlns:strings="using:PhoenixReadCopilot.Strings"
                                mc:Ignorable="d">

    <UserControl.Resources>
        <converters:ChildCommentTextConverter x:Key="ChildCommentTextConverter"/>
    </UserControl.Resources>

    <Grid Padding="0,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  顶部剧评标题、评分与排序切换，与评论列表位置和样式完全一致  -->
        <Grid Padding="12,0" Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource ObjectToVisibilityReverseConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="12,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <TextBlock VerticalAlignment="Center"
                           FontSize="14"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="剧评"/>
                <Border Padding="6,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="4"
                        Visibility="{x:Bind ViewModel.DramaScore, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <TextBlock FontSize="11"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{x:Bind ViewModel.DramaScore, Mode=OneWay}"/>
                </Border>
            </StackPanel>
            <ComboBox x:Name="SortTypeComboBox"
                      Grid.Column="1"
                      MinWidth="100"
                      VerticalAlignment="Center"
                      IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                      ItemsSource="{x:Bind ViewModel.Sorts, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SortType, Mode=OneWay}"
                      SelectionChanged="OnSortChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="api:CommentSortOrder">
                        <TextBlock Text="{x:Bind Converter={StaticResource SortTypeTextConverter}}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <!--  二级回复面板返回按钮  -->
        <HyperlinkButton Margin="12,0"
                         HorizontalAlignment="Left"
                         Command="{x:Bind ViewModel.BackToMainCommand, Mode=OneWay}"
                         Content="{x:Bind strings:Resources.BackToPrevious}"
                         Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>

        <!--  中间剧评列表，条目排版与 CommentItemControl 完全一致  -->
        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource ObjectToVisibilityReverseConverter}}">
            <ScrollViewer x:Name="ReviewScrollView"
                          Padding="0"
                          Style="{StaticResource PageScrollViewerStyle}">
                <StackPanel Margin="12,0">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Reviews, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="items:DramaReviewItemViewModel">
                                <Grid Margin="0,0,0,4"
                                      Padding="12"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderBrush="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                      BorderThickness="1"
                                      ColumnSpacing="12"
                                      CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!--  左侧头像  -->
                                    <StackPanel>
                                        <Button VerticalAlignment="Top" Style="{StaticResource AvatarButtonStyle}">
                                            <PersonPicture Width="40"
                                                           Height="40"
                                                           DisplayName="{x:Bind UserName, Mode=OneWay}"
                                                           ProfilePicture="{x:Bind Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>
                                        </Button>
                                    </StackPanel>

                                    <!--  右侧内容区域（3行：用户名+时间、评语文本、点赞行）  -->
                                    <Grid Grid.Column="1" RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!--  第一行：用户名与发布时间  -->
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontWeight="Bold"
                                                       Style="{StaticResource BodyTextBlockStyle}"
                                                       Text="{x:Bind UserName, Mode=OneWay}"/>
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Text="{x:Bind RelativeTime, Mode=OneWay}"
                                                       ToolTipService.ToolTip="{x:Bind ActualTime, Mode=OneWay}"/>
                                        </Grid>

                                        <!--  第二行：正文内容  -->
                                        <Grid Grid.Row="1">
                                            <comp:EmoteTextBlock HorizontalAlignment="Left" Text="{x:Bind Content, Mode=OneWay}"/>
                                        </Grid>

                                        <!--  第三行：点赞、回复数、回复按钮  -->
                                        <Grid Grid.Row="2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ToggleButton VerticalAlignment="Center"
                                                          Command="{x:Bind ToggleLikeCommand, Mode=OneWay}"
                                                          IsChecked="{x:Bind IsLiked, Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <ic:SymbolIcon VerticalAlignment="Center"
                                                                   FontSize="12"
                                                                   IconVariant="{x:Bind IsLiked, Mode=OneWay, Converter={StaticResource BoolToIconVariantConverter}}"
                                                                   Symbol="ThumbLike"/>
                                                    <TextBlock VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Text="{x:Bind LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
                                                </StackPanel>
                                            </ToggleButton>

                                            <!--  回复条数链接  -->
                                            <StackPanel Grid.Column="1"
                                                        HorizontalAlignment="Left"
                                                        Visibility="{x:Bind ReplyCount, Converter={StaticResource ObjectToVisibilityConverter}, Mode=OneWay}">
                                                <HyperlinkButton Command="{x:Bind ShowMoreCommand, Mode=OneWay}">
                                                    <TextBlock FontSize="12" Text="{x:Bind ReplyCount, Converter={StaticResource ChildCommentTextConverter}, Mode=OneWay}"/>
                                                </HyperlinkButton>
                                            </StackPanel>

                                            <!--  回复按钮  -->
                                            <Button Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Command="{x:Bind ShowMoreCommand, Mode=OneWay}"
                                                    Style="{StaticResource SmallIconButtonStyle}"
                                                    ToolTipService.ToolTip="{x:Bind strings:Resources.Reply}">
                                                <ic:SymbolIcon FontSize="12" Symbol="CommentMention"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <base:EmptyHolder Description="暂无剧评，快来发表第一条评价吧！"
                              Emoji="&#x1FAE2;"
                              Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <base:EmptyHolder.ActionElement>
                    <HyperlinkButton Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" Content="{x:Bind strings:Resources.Refresh}"/>
                </base:EmptyHolder.ActionElement>
            </base:EmptyHolder>
            <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        </Grid>

        <!--  剧评二级回复面板（复用 CommentDetailPanel）  -->
        <local:CommentDetailPanel Grid.Row="1"
                                  Grid.RowSpan="2"
                                  ViewModel="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>

        <!--  底部发送剧评区域（带评分星级与统一的 CommentTextBox）  -->
        <Border Grid.Row="2"
                Margin="12,0"
                Padding="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.SelectedItem, Mode=OneWay, Converter={StaticResource ObjectToVisibilityReverseConverter}}">
            <StackPanel Spacing="6">
                <!--  评分星级  -->
                <StackPanel Margin="4,2,0,2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="8">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="我的评分:"/>
                    <RatingControl VerticalAlignment="Center"
                                   IsEnabled="{x:Bind ViewModel.CanSendReview, Mode=OneWay}"
                                   MaxRating="5"
                                   Value="{x:Bind ViewModel.Rating, Mode=TwoWay}"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Text="{x:Bind ViewModel.Rating, Mode=OneWay}"/>
                </StackPanel>

                <!--  输入框与发送按钮  -->
                <local:CommentTextBox x:Name="ReviewCommentBox"
                                      IsEnabled="{x:Bind ViewModel.CanSendReview, Mode=OneWay}"
                                      SendCommand="{x:Bind ViewModel.SendReviewCommand, Mode=OneWay}"/>
            </StackPanel>
        </Border>
    </Grid>
</local:DramaReviewMainPanelBase>
