<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Comment.CommentMainPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:api="using:PhoenixReadApi"
             xmlns:components="using:PhoenixReadCopilot.Controls.Components"
             xmlns:components1="using:PhoenixReadCopilot.ViewModels.Components"
             xmlns:cvt="using:PhoenixReadCopilot.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:essential="using:WinUI3Package"
             xmlns:local="using:PhoenixReadCopilot.Controls.Comment"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:PhoenixReadCopilot.Strings"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             mc:Ignorable="d">

    <Grid Padding="0,12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Padding="12,0" Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.HasSelectedItem), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="12,0,0,0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       Text="{x:Bind strings:Resources.Comments}"/>
            <ComboBox x:Name="SortTypeComboBox"
                      Grid.Column="1"
                      MinWidth="100"
                      VerticalAlignment="Center"
                      essential:ComboBoxHelper.AcrylicWorkaround="True"
                      IsEnabled="{x:Bind cvt:Converter.InvertBool(ViewModel.IsLoading), Mode=OneWay}"
                      ItemsSource="{x:Bind ViewModel.Sorts, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SortType, Mode=OneWay}"
                      SelectionChanged="OnSortChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="api:CommentSortOrder">
                        <TextBlock Text="{x:Bind cvt:Converter.CommentSortOrderToText((api:CommentSortOrder))}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <HyperlinkButton Margin="12,0"
                         HorizontalAlignment="Left"
                         Command="{x:Bind ViewModel.BackToMainCommand, Mode=OneWay}"
                         Content="{x:Bind strings:Resources.BackToPrevious}"
                         Visibility="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"/>
        <Grid Grid.Row="1" Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.HasSelectedItem), Mode=OneWay}">
            <ScrollViewer x:Name="CommentScrollView"
                          Padding="0"
                          SizeChanged="OnScrollViewSizeChanged"
                          Style="{StaticResource PageScrollViewerStyle}"
                          ViewChanged="OnViewChanged">
                <StackPanel Margin="12,0">
                    <local:CommentItemControl Margin="0,0,0,4"
                                              ShowMoreCommand="{x:Bind ViewModel.TopItem.ShowMoreCommand, Mode=OneWay}"
                                              ViewModel="{x:Bind ViewModel.TopItem.Data, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasTopItem, Mode=OneWay}"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="components1:CommentDetailViewModel">
                                <local:CommentItemControl Margin="0,2"
                                                          ShowMoreCommand="{x:Bind ShowMoreCommand}"
                                                          ViewModel="{x:Bind Data}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
            <components:EmptyHolder Description="{x:Bind strings:Resources.NoReply}"
                                    Emoji="&#x1FAE2;"
                                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
                <components:EmptyHolder.ActionElement>
                    <HyperlinkButton Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" Content="{x:Bind strings:Resources.Refresh}"/>
                </components:EmptyHolder.ActionElement>
            </components:EmptyHolder>
            <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        </Grid>
        <local:CommentDetailPanel Grid.Row="1"
                                  Grid.RowSpan="2"
                                  ViewModel="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.HasSelectedItem, Mode=OneWay}"/>
        <local:CommentTextBox Grid.Row="2"
                              Margin="12,0"
                              IsEnabled="{x:Bind cvt:Converter.InvertBool(ViewModel.IsReplying), Mode=OneWay}"
                              ReplyTip="{x:Bind ViewModel.ReplyTarget, Mode=OneWay}"
                              ResetSelectedCommand="{x:Bind ViewModel.ResetReplyTargetCommand, Mode=OneWay}"
                              SendCommand="{x:Bind ViewModel.SendReplyCommand, Mode=OneWay}"
                              Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.HasSelectedItem), Mode=OneWay}"/>
    </Grid>
</UserControl>
