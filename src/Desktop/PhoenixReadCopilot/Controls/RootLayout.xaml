<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.RootLayout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:CommunityToolkit.WinUI.Animations"
             xmlns:components="using:PhoenixReadCopilot.Controls.Components"
             xmlns:cvt="using:PhoenixReadCopilot.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:essential="using:WinUI3Package"
             xmlns:ic="using:FluentIcons.WinUI"
             xmlns:local="using:PhoenixReadCopilot.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:PhoenixReadCopilot.Strings"
             xmlns:viewmodels="using:PhoenixReadCopilot.ViewModels.Items"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="AppNavItemTemplate" x:DataType="viewmodels:AppNavigationItemViewModel">
            <components:AppNavigationViewItem Content="{x:Bind Title}"
                                              IsSelected="{x:Bind IsSelected, Mode=TwoWay}"
                                              SelectsOnInvoked="True"
                                              ShowUnread="{x:Bind ShowUnread, Mode=OneWay}"
                                              Style="{StaticResource MainNavigationViewItemStyle}"
                                              Symbol="{x:Bind Symbol}"
                                              Tag="{x:Bind}"
                                              Visibility="{x:Bind IsVisible, Mode=OneWay}"/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="WideState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="{StaticResource WindowNarrowMinWidth}"/>
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="NarrowState">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SearchBox.MinWidth" Value="100"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="PlayerStates">
                <VisualState x:Name="NormalState"/>
                <VisualState x:Name="PlayerState">
                    <VisualState.Setters>
                        <Setter Target="MainGrid.BorderThickness" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <TitleBar x:Name="MainTitleBar"
                  Title="{x:Bind strings:Resources.AppName}"
                  BackRequested="OnBackRequested"
                  IsBackButtonEnabled="True"
                  IsBackButtonVisible="{x:Bind ViewModel.IsOverlayOpen, Mode=OneWay}">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Logo/Icon.ico"/>
            </TitleBar.IconSource>

            <TitleBar.LeftHeader>
                <StackPanel Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Orientation="Horizontal"
                            Spacing="2"
                            Visibility="{x:Bind ViewModel.IsTopNavBarShown, Mode=OneWay}">
                    <components:TopNavigationItem Click="OnFavoriteButtonClick"
                                                  Symbol="StarLineHorizontal3"
                                                  ToolTipService.ToolTip="{x:Bind strings:Resources.Favorite}"/>
                    <components:TopNavigationItem Click="OnViewLaterButtonClick"
                                                  Symbol="CalendarClock"
                                                  ToolTipService.ToolTip="{x:Bind strings:Resources.ViewLater}"/>
                    <components:TopNavigationItem Click="OnHistoryButtonClick"
                                                  Symbol="History"
                                                  ToolTipService.ToolTip="{x:Bind strings:Resources.History}"/>
                </StackPanel>
            </TitleBar.LeftHeader>

            <components:AppSearchBox x:Name="SearchBox"
                                     MinWidth="380"
                                     MaxWidth="500"
                                     Margin="20,0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"/>

            <TitleBar.RightHeader>
                <StackPanel Orientation="Horizontal">
                    <local:Pinner Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <components:HeaderAccountControl/>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <TitleBar x:Name="SecondaryTitleBar"
                  Title="{x:Bind strings:Resources.AppName}"
                  BackRequested="OnVideoBackRequested"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1"
                  IsBackButtonVisible="False"
                  Visibility="Collapsed">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/Logo/Icon.ico"/>
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        FooterMenuItemsSource="{x:Bind ViewModel.FooterItems, Mode=OneWay}"
                        MenuItemTemplate="{StaticResource AppNavItemTemplate}"
                        MenuItemsSource="{x:Bind ViewModel.MenuItems, Mode=OneWay}"
                        SelectionFollowsFocus="Disabled"
                        Style="{StaticResource MainNavigationViewStyle}">
            <Grid x:Name="MainGrid">
                <Grid Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.IsInitialLoading), Mode=OneWay}">
                    <Frame x:Name="MainFrame" Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.IsOverlayOpen), Mode=OneWay}"/>
                    <Grid x:Name="OverlayGrid" Visibility="{x:Bind ViewModel.IsOverlayOpen, Mode=OneWay}">
                        <Frame x:Name="OverlayFrame"/>
                    </Grid>
                    <animations:Implicit.ShowAnimations>
                        <animations:OpacityAnimation From="0"
                                                     To="1"
                                                     Duration="0:0:0.26"/>
                    </animations:Implicit.ShowAnimations>
                </Grid>
                <components:ShimmerLayout HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsActive="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.IsInitialLoading, Mode=OneWay}">
                    <animations:Implicit.HideAnimations>
                        <animations:OpacityAnimation From="1"
                                                     To="0"
                                                     Duration="0:0:0.26"/>
                    </animations:Implicit.HideAnimations>
                </components:ShimmerLayout>
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
