<?xml version="1.0" encoding="utf-8" ?>
<local:ActorRankCardControlBase x:Class="PhoenixReadCopilot.Controls.Rank.ActorRankCardControl"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:base="using:WinUIKernel.Share.Base"
                                xmlns:community="using:CommunityToolkit.WinUI.Controls"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:ic="using:FluentIcons.WinUI"
                                xmlns:lab="using:CommunityToolkit.Labs.WinUI.MarqueeTextRns"
                                xmlns:local="using:PhoenixReadCopilot.Controls.Rank"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                mc:Ignorable="d">

    <base:CardControl Padding="16,14"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      Command="{x:Bind ViewModel.ShowUserSpaceCommand, Mode=OneWay}"
                      CornerRadius="{StaticResource ControlCornerRadius}">
        <Grid VerticalAlignment="Center" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--  0: 排名徽章  -->
            <community:SwitchPresenter TargetType="x:Int32" Value="{x:Bind ViewModel.Rank, Mode=OneWay}">
                <community:Case Value="1">
                    <!--  冠军金牌  -->
                    <Border Width="36"
                            Height="26"
                            HorizontalAlignment="Center"
                            Background="#FFB800"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="1"/>
                    </Border>
                </community:Case>
                <community:Case Value="2">
                    <!--  亚军银牌  -->
                    <Border Width="36"
                            Height="26"
                            HorizontalAlignment="Center"
                            Background="#94A3B8"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="2"/>
                    </Border>
                </community:Case>
                <community:Case Value="3">
                    <!--  季军铜牌  -->
                    <Border Width="36"
                            Height="26"
                            HorizontalAlignment="Center"
                            Background="#D97706"
                            CornerRadius="6">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="3"/>
                    </Border>
                </community:Case>
            </community:SwitchPresenter>

            <!--  4+ 名  -->
            <Border Width="36"
                    Height="26"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="6"
                    Visibility="{x:Bind ViewModel.IsTopRank, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.RankDisplay, Mode=OneWay}"/>
            </Border>


            <!--  1: 演员头像  -->
            <PersonPicture Grid.Column="1"
                           Width="58"
                           Height="58"
                           VerticalAlignment="Center"
                           DisplayName="{x:Bind ViewModel.Name, Mode=OneWay}"
                           ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>

            <!--  2: 核心信息  -->
            <StackPanel Grid.Column="2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="6">
                <!--  姓名与代表作  -->
                <StackPanel VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="10">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid MaxWidth="420"
                          Padding="8,2"
                          VerticalAlignment="Center"
                          Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          ColumnSpacing="4"
                          CornerRadius="4"
                          Visibility="{x:Bind ViewModel.HasRepresentativeWork, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ic:SymbolIcon Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Symbol="MoviesAndTv"/>
                        <lab:MarqueeText Grid.Column="1"
                                         VerticalAlignment="Center"
                                         Behavior="Looping"
                                         FontSize="12"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         Text="{x:Bind ViewModel.RepresentativeWorkDisplay, Mode=OneWay}"/>
                    </Grid>
                </StackPanel>

                <!--  副标题/标签  -->
                <TextBlock FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.Subtitles, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.HasSubtitles, Mode=OneWay}"/>
            </StackPanel>

            <!--  3: 热度与箭头指示  -->
            <StackPanel Grid.Column="3"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="12">
                <!--  人气胶囊  -->
                <Border Padding="10,6"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6">
                        <ic:SymbolIcon VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="#FF5722"
                                       Symbol="Fire"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF5722"
                                   Text="{x:Bind ViewModel.Popularity, Mode=OneWay}"/>
                    </StackPanel>
                </Border>

                <!--  前往主页指示图标  -->
                <ic:SymbolIcon VerticalAlignment="Center"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Symbol="ChevronRight"/>
            </StackPanel>
        </Grid>
    </base:CardControl>
</local:ActorRankCardControlBase>
