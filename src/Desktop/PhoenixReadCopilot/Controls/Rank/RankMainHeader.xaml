<?xml version="1.0" encoding="utf-8" ?>
<local:RankPageControlBase x:Class="PhoenixReadCopilot.Controls.Rank.RankMainHeader"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:ic="using:FluentIcons.WinUI"
                           xmlns:local="using:PhoenixReadCopilot.Controls.Rank"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:strings="using:PhoenixReadCopilot.Strings"
                           mc:Ignorable="d">

    <Grid Padding="16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <local:RankSectionItemControl VerticalAlignment="Center"
                                      FontWeight="Bold"
                                      ViewModel="{x:Bind ViewModel.SelectedSection, Mode=OneWay}"/>
        <SelectorBar x:Name="BoardSelector"
                     Grid.Column="1"
                     Margin="16,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="{x:Bind ViewModel.IsLeaderboardSection, Mode=OneWay}"/>
        <Button Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="{x:Bind strings:Resources.Refresh}"
                Command="{x:Bind ViewModel.RefreshVideoCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ic:SymbolIcon VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Symbol="ArrowSync"/>
                <TextBlock VerticalAlignment="Center" Text="{x:Bind strings:Resources.Refresh}"/>
            </StackPanel>
        </Button>
    </Grid>
</local:RankPageControlBase>
