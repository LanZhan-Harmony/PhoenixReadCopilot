<?xml version="1.0" encoding="utf-8" ?>
<local:RankPageControlBase x:Class="PhoenixReadCopilot.Controls.Rank.RankMainBody"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:ext="using:PhoenixReadCopilot.Extensions"
                           xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                           xmlns:local="using:PhoenixReadCopilot.Controls.Rank"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:strings="using:PhoenixReadCopilot.Strings"
                           mc:Ignorable="d">

    <local:RankPageControlBase.Resources>
        <DataTemplate x:Key="DramaTemplate" x:DataType="items:RankSectionItemViewModel">
            <local:RankDramaBody ViewModel="{x:Bind PageViewModel, Mode=OneWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="ActorTemplate" x:DataType="items:RankSectionItemViewModel">
            <local:RankActorBody ViewModel="{x:Bind PageViewModel, Mode=OneWay}"/>
        </DataTemplate>
        <ext:RankSectionTemplateSelector x:Key="SectionSelector"
                                         ActorTemplate="{StaticResource ActorTemplate}"
                                         DramaTemplate="{StaticResource DramaTemplate}"/>
    </local:RankPageControlBase.Resources>

    <Grid>
        <ContentControl HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{x:Bind ViewModel.SelectedSection, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource SectionSelector}"
                        Style="{StaticResource AppContentControlStyle}"/>
        <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}"/>
    </Grid>
</local:RankPageControlBase>
