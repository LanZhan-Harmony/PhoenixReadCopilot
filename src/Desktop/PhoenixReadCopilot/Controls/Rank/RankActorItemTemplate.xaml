<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="PhoenixReadCopilot.Controls.Rank.RankActorItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:WinUIKernel.Share.Base"
                    xmlns:community="using:CommunityToolkit.WinUI.Controls"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                    xmlns:lab="using:CommunityToolkit.Labs.WinUI.MarqueeTextRns"
                    xmlns:strings="using:PhoenixReadCopilot.Strings">

    <DataTemplate x:Key="RankActorItemTemplate" x:DataType="items:ActorItemViewModel">
        <Button Command="{x:Bind ShowUserSpaceCommand}"
                DataContext="{x:Bind}"
                Style="{StaticResource ListRepeaterItemStyle}">
            <Grid VerticalAlignment="Center" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!--  0: 排名徽章  -->
                <community:SwitchPresenter TargetType="x:Int32" Value="{x:Bind Rank}">
                    <community:Case Value="1">
                        <!--  冠军金牌  -->
                        <Border Width="36"
                                Height="26"
                                HorizontalAlignment="Center"
                                Background="#FFB800"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="1"/>
                        </Border>
                    </community:Case>
                    <community:Case Value="2">
                        <!--  亚军银牌  -->
                        <Border Width="36"
                                Height="26"
                                HorizontalAlignment="Center"
                                Background="#94A3B8"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="2"/>
                        </Border>
                    </community:Case>
                    <community:Case Value="3">
                        <!--  季军铜牌  -->
                        <Border Width="36"
                                Height="26"
                                HorizontalAlignment="Center"
                                Background="#D97706"
                                CornerRadius="6">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="3"/>
                        </Border>
                    </community:Case>
                </community:SwitchPresenter>

                <!--  4+ 名  -->
                <Border Width="36"
                        Height="26"
                        HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Visibility="{x:Bind IsTopRank, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind RankDisplay}"/>
                </Border>


                <!--  1: 演员头像  -->
                <PersonPicture Grid.Column="1"
                               Width="58"
                               Height="58"
                               VerticalAlignment="Center"
                               DisplayName="{x:Bind Name}"
                               ProfilePicture="{x:Bind Avatar, Converter={StaticResource BitmapConverter}}"/>

                <!--  2: 核心信息  -->
                <StackPanel Grid.Column="2"
                            Margin="4,0,0,0"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <!--  姓名与代表作  -->
                    <StackPanel VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="10">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                   Text="{x:Bind Name}"
                                   TextTrimming="CharacterEllipsis"/>
                        <Grid MaxWidth="420"
                              Padding="8,2"
                              VerticalAlignment="Center"
                              Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1"
                              ColumnSpacing="4"
                              CornerRadius="4"
                              Visibility="{x:Bind HasRepresentativeWork}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ic:SymbolIcon Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           Symbol="MoviesAndTv"/>
                            <lab:MarqueeText Grid.Column="1"
                                             VerticalAlignment="Center"
                                             Behavior="Looping"
                                             FontSize="12"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             Text="{x:Bind RepresentativeWorkDisplay}"/>
                        </Grid>
                    </StackPanel>

                    <!--  副标题/标签  -->
                    <TextBlock FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind Subtitles}"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind HasSubtitles}"/>
                </StackPanel>

                <!--  3: 热度与箭头指示  -->
                <StackPanel Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="12">
                    <!--  人气胶囊  -->
                    <Border Padding="10,6"
                            VerticalAlignment="Center"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                            <ic:SymbolIcon VerticalAlignment="Center"
                                           FontSize="14"
                                           Foreground="#FF5722"
                                           Symbol="Fire"/>
                            <TextBlock VerticalAlignment="Center"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#FF5722"
                                       Text="{x:Bind Popularity}"/>
                        </StackPanel>
                    </Border>

                    <!--  前往主页指示图标  -->
                    <ic:SymbolIcon VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Symbol="ChevronRight"/>
                </StackPanel>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
