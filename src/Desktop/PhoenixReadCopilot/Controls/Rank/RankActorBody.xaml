<?xml version="1.0" encoding="utf-8" ?>
<local:RankPageControlBase x:Class="PhoenixReadCopilot.Controls.Rank.RankActorBody"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:essential="using:WinUI3Package"
                           xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                           xmlns:local="using:PhoenixReadCopilot.Controls.Rank"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           mc:Ignorable="d">

    <local:RankPageControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:RankActorItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:RankPageControlBase.Resources>

    <essential:RevealFocusPanel x:Name="ListViewRevealFocusPanel">
        <ScrollViewer x:Name="ActorScrollView" Style="{StaticResource PageScrollViewerStyle}">
            <ItemsRepeater x:Name="ActorRepeater"
                           Margin="16,12"
                           ElementPrepared="ActorRepeater_ElementPrepared"
                           ItemTemplate="{StaticResource RankActorItemTemplate}"
                           ItemsSource="{x:Bind ViewModel.Actors, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </essential:RevealFocusPanel>
</local:RankPageControlBase>
