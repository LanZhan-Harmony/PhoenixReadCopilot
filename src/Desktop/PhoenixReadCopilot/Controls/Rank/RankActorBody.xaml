<?xml version="1.0" encoding="utf-8" ?>
<local:RankPageControlBase x:Class="PhoenixReadCopilot.Controls.Rank.RankActorBody"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                           xmlns:local="using:PhoenixReadCopilot.Controls.Rank"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           mc:Ignorable="d">

    <ScrollViewer x:Name="ActorScrollView" Style="{StaticResource PageScrollViewerStyle}">
        <Grid Margin="16,12">
            <ItemsRepeater x:Name="ActorRepeater"
                           ItemsSource="{x:Bind ViewModel.Actors, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="10"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:ActorItemViewModel">
                        <local:ActorRankCardControl ViewModel="{x:Bind Mode=OneWay}"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </Grid>
    </ScrollViewer>
</local:RankPageControlBase>
