<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="PhoenixReadCopilot.Controls.Rank.RankVideoItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                    xmlns:strings="using:PhoenixReadCopilot.Strings">

    <DataTemplate x:Key="RankVideoItemTemplate" x:DataType="items:VideoItemViewModel">
        <Button Command="{x:Bind PlayCommand}"
                DataContext="{x:Bind}"
                Style="{StaticResource GridRepeaterItemStyle}">
            <Button.ContextFlyout>
                <MenuFlyout ShouldConstrainToRootBounds="False">
                    <MenuFlyoutItem Command="{x:Bind OpenInNewWindowCommand}" Text="{x:Bind strings:Resources.OpenInNewWindow}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="WindowPlay"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind AddToViewLaterCommand}" Text="{x:Bind strings:Resources.AddToViewLater}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="CalendarAdd"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind PinCommand}" Text="{x:Bind strings:Resources.FixContent}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="Pin"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <Grid x:Name="TemplateContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!--  海报封面容器  -->
                <components:CoverImage x:Name="CoverImage"
                                       Grid.Row="0"
                                       Margin="6"
                                       CornerRadius="5"
                                       Source="{x:Bind Cover}"/>

                <!--  左上角：排名徽章  -->
                <Border Grid.Row="0"
                        Margin="12"
                        Padding="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind HasRank}">
                    <TextBlock FontSize="11"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{x:Bind RankText}"/>
                </Border>

                <!--  右上角：评分徽章  -->
                <Border Grid.Row="0"
                        Margin="12"
                        Padding="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="#B0D32F2F"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind HasScore}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock FontWeight="Bold"
                                   Foreground="Gold"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind Score}"/>
                        <ic:SymbolIcon FontSize="{StaticResource CaptionTextBlockFontSize}"
                                       Foreground="Gold"
                                       IconVariant="Filled"
                                       Symbol="Star"/>
                    </StackPanel>
                </Border>

                <!--  信息与元数据  -->
                <Grid Grid.Row="1"
                      Padding="10,0,10,8"
                      RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold"
                               MaxLines="2"
                               Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"/>

                    <!--  底部行：题材分类 / 热度播放量  -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--  标签  -->
                        <components:IconTextBlock Grid.Column="0"
                                                  IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Symbol="Tag"
                                                  Text="{x:Bind TagName}"
                                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                  Visibility="{x:Bind TagName, Converter={StaticResource ObjectToVisibilityConverter}}"/>

                        <!--  热度或播放量  -->
                        <components:IconTextBlock Grid.Column="1"
                                                  IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Symbol="PlayCircle"
                                                  Text="{x:Bind HeatOrPlayCountText}"
                                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                  ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"
                                                  Visibility="{x:Bind HeatOrPlayCountText, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
