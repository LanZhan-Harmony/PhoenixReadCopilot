<?xml version="1.0" encoding="utf-8" ?>
<local:UserControlBase x:Class="PhoenixReadCopilot.Controls.User.UserMainBody"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:animations="using:CommunityToolkit.WinUI.Animations"
                       xmlns:base="using:WinUIKernel.Share.Base"
                       xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:essential="using:WinUI3Package"
                       xmlns:ic="using:FluentIcons.WinUI"
                       xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                       xmlns:local="using:PhoenixReadCopilot.Controls.User"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:strings="using:PhoenixReadCopilot.Strings"
                       mc:Ignorable="d">

    <local:UserControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:UserVideoItemTemplate/>
                <local:CircleFeedItemTemplate/>
                <local:UserReviewItemTemplate/>
                <local:UserItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:UserControlBase.Resources>

    <Grid>
        <!--  1. 短剧网格模式  -->
        <essential:RevealFocusPanel x:Name="VideoRevealFocusPanel" Visibility="{x:Bind ViewModel.IsVideoViewVisible, Mode=OneWay}">
            <ScrollViewer x:Name="VideoScrollView"
                          Padding="0"
                          Style="{StaticResource PageScrollViewerStyle}">
                <ItemsRepeater x:Name="VideoItemsRepeater"
                               Margin="16,12"
                               ElementClearing="VideoItemsRepeater_ElementClearing"
                               ElementPrepared="VideoItemsRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource UserVideoItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                               Layout="{StaticResource VideoLayout}"/>
            </ScrollViewer>
        </essential:RevealFocusPanel>

        <!--  2. 剧评列表模式  -->
        <essential:RevealFocusPanel x:Name="ReviewRevealFocusPanel" Visibility="{x:Bind ViewModel.IsReviewViewVisible, Mode=OneWay}">
            <ScrollViewer x:Name="ReviewScrollView"
                          Padding="0"
                          Style="{StaticResource PageScrollViewerStyle}">
                <ItemsRepeater x:Name="ReviewItemsRepeater"
                               Margin="16,12"
                               ElementClearing="ReviewItemsRepeater_ElementClearing"
                               ElementPrepared="ReviewItemsRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource UserReviewItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.Reviews, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10"/>
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </essential:RevealFocusPanel>

        <!--  3. 红果圈瀑布流/网格模式  -->
        <essential:RevealFocusPanel x:Name="CircleRevealFocusPanel" Visibility="{x:Bind ViewModel.IsCircleViewVisible, Mode=OneWay}">
            <ScrollViewer x:Name="CircleScrollView"
                          Padding="0"
                          Style="{StaticResource PageScrollViewerStyle}">
                <ItemsRepeater x:Name="CircleItemsRepeater"
                               Margin="16,12"
                               ElementClearing="CircleItemsRepeater_ElementClearing"
                               ElementPrepared="CircleItemsRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource CircleFeedItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.CircleFeeds, Mode=OneWay}"
                               Layout="{StaticResource VideoLayout}"/>
            </ScrollViewer>
        </essential:RevealFocusPanel>

        <!--  4. 关注/粉丝用户卡片模式  -->
        <essential:RevealFocusPanel x:Name="RelationRevealFocusPanel" Visibility="{x:Bind ViewModel.IsRelationViewVisible, Mode=OneWay}">
            <ScrollViewer x:Name="RelationScrollView"
                          Padding="0"
                          Style="{StaticResource PageScrollViewerStyle}">
                <ItemsRepeater x:Name="RelationItemsRepeater"
                               Margin="16,12"
                               ElementClearing="RelationItemsRepeater_ElementClearing"
                               ElementPrepared="RelationItemsRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource UserItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.Relations, Mode=OneWay}"
                               Layout="{StaticResource UserLayout}"/>
            </ScrollViewer>
        </essential:RevealFocusPanel>

        <!--  空状态占位 (仅当非加载中且真正无数据时呈现)  -->
        <base:EmptyHolder Description="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                          Emoji="&#x1F4DA;"
                          Visibility="{x:Bind ViewModel.ShowEmptyHolder, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <!--  加载动画  -->
        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</local:UserControlBase>
