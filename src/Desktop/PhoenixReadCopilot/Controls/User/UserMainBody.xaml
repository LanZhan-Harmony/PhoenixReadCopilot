<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.User.UserMainBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:PhoenixReadCopilot.Controls.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:essential="using:WinUI3Package"
             xmlns:ext="using:PhoenixReadCopilot.Extensions"
             xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
             xmlns:local="using:PhoenixReadCopilot.Controls.User"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:PhoenixReadCopilot.Strings"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:UserDramaItemTemplate/>
                <local:UserReservationDramaItemTemplate/>
                <local:CircleFeedItemTemplate/>
                <local:UserReviewItemTemplate/>
                <local:UserItemTemplate/>
            </ResourceDictionary.MergedDictionaries>

            <!--  1. 短剧网格模式模板  -->
            <DataTemplate x:Key="VideoSectionTemplate" x:DataType="items:IUserSpaceContentItem">
                <essential:RevealFocusPanel Loaded="OnRevealFocusPanelLoaded">
                    <ScrollViewer Loaded="OnScrollViewerLoaded"
                                  Style="{StaticResource PageScrollViewerStyle}"
                                  Unloaded="OnScrollViewerUnloaded">
                        <ItemsRepeater Margin="16,12"
                                       ElementClearing="VideoItemsRepeater_ElementClearing"
                                       ElementPrepared="VideoItemsRepeater_ElementPrepared"
                                       ItemTemplate="{StaticResource UserDramaItemTemplate}"
                                       ItemsSource="{x:Bind PageViewModel.Videos, Mode=OneWay}"
                                       Layout="{StaticResource VideoLayout}"/>
                    </ScrollViewer>
                </essential:RevealFocusPanel>
            </DataTemplate>

            <!--  2. 剧评列表模式模板  -->
            <DataTemplate x:Key="ReviewSectionTemplate" x:DataType="items:IUserSpaceContentItem">
                <essential:RevealFocusPanel Loaded="OnRevealFocusPanelLoaded">
                    <ScrollViewer Loaded="OnScrollViewerLoaded"
                                  Style="{StaticResource PageScrollViewerStyle}"
                                  Unloaded="OnScrollViewerUnloaded">
                        <ItemsRepeater Margin="16,12"
                                       ElementClearing="ReviewItemsRepeater_ElementClearing"
                                       ElementPrepared="ReviewItemsRepeater_ElementPrepared"
                                       ItemTemplate="{StaticResource UserReviewItemTemplate}"
                                       ItemsSource="{x:Bind PageViewModel.Reviews, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="10"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </essential:RevealFocusPanel>
            </DataTemplate>

            <!--  3. 红果圈瀑布流/网格模式模板  -->
            <DataTemplate x:Key="CircleSectionTemplate" x:DataType="items:IUserSpaceContentItem">
                <essential:RevealFocusPanel Loaded="OnRevealFocusPanelLoaded">
                    <ScrollViewer Loaded="OnScrollViewerLoaded"
                                  Style="{StaticResource PageScrollViewerStyle}"
                                  Unloaded="OnScrollViewerUnloaded">
                        <ItemsRepeater Margin="16,12"
                                       ElementClearing="CircleItemsRepeater_ElementClearing"
                                       ElementPrepared="CircleItemsRepeater_ElementPrepared"
                                       ItemTemplate="{StaticResource CircleFeedItemTemplate}"
                                       ItemsSource="{x:Bind PageViewModel.CircleFeeds, Mode=OneWay}"
                                       Layout="{StaticResource VideoLayout}"/>
                    </ScrollViewer>
                </essential:RevealFocusPanel>
            </DataTemplate>

            <!--  4. 关注/粉丝用户卡片模式模板  -->
            <DataTemplate x:Key="RelationSectionTemplate" x:DataType="items:IUserSpaceContentItem">
                <essential:RevealFocusPanel Loaded="OnRevealFocusPanelLoaded">
                    <ScrollViewer Loaded="OnScrollViewerLoaded"
                                  Style="{StaticResource PageScrollViewerStyle}"
                                  Unloaded="OnScrollViewerUnloaded">
                        <ItemsRepeater Margin="16,12"
                                       ElementClearing="RelationItemsRepeater_ElementClearing"
                                       ElementPrepared="RelationItemsRepeater_ElementPrepared"
                                       ItemTemplate="{StaticResource UserItemTemplate}"
                                       ItemsSource="{x:Bind PageViewModel.Relations, Mode=OneWay}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout ItemsStretch="Fill"
                                                   MinColumnSpacing="4"
                                                   MinItemHeight="84"
                                                   MinItemWidth="220"
                                                   MinRowSpacing="4"/>
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </ScrollViewer>
                </essential:RevealFocusPanel>
            </DataTemplate>

            <!--  5. 待播预约网格模式模板（模仿上新日历待播卡片风格，保留预约状态交互）  -->
            <DataTemplate x:Key="ReservationSectionTemplate" x:DataType="items:IUserSpaceContentItem">
                <essential:RevealFocusPanel Loaded="OnRevealFocusPanelLoaded">
                    <ScrollViewer Loaded="OnScrollViewerLoaded"
                                  Style="{StaticResource PageScrollViewerStyle}"
                                  Unloaded="OnScrollViewerUnloaded">
                        <ItemsRepeater Margin="16,12"
                                       ElementClearing="ReservationItemsRepeater_ElementClearing"
                                       ElementPrepared="ReservationItemsRepeater_ElementPrepared"
                                       ItemTemplate="{StaticResource UserReservationDramaItemTemplate}"
                                       ItemsSource="{x:Bind PageViewModel.Reservations, Mode=OneWay}"
                                       Layout="{StaticResource VideoLayout}"/>
                    </ScrollViewer>
                </essential:RevealFocusPanel>
            </DataTemplate>

            <!--  数据模板选择器  -->
            <ext:UserSectionTemplateSelector x:Key="SectionSelector"
                                             CircleTemplate="{StaticResource CircleSectionTemplate}"
                                             RelationTemplate="{StaticResource RelationSectionTemplate}"
                                             ReservationTemplate="{StaticResource ReservationSectionTemplate}"
                                             ReviewTemplate="{StaticResource ReviewSectionTemplate}"
                                             DramaTemplate="{StaticResource VideoSectionTemplate}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!--  主内容切换容器（纯 MVVM 绑定 CurrentContent，由 TemplateSelector 自动响应切换）  -->
        <ContentControl x:Name="MainContentControl"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Content="{x:Bind ViewModel.CurrentContent, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource SectionSelector}"
                        Style="{StaticResource AppContentControlStyle}"/>

        <!--  空状态占位 (仅当非加载中且真正无数据时呈现)  -->
        <components:EmptyHolder Description="{x:Bind ViewModel.EmptyDescription, Mode=OneWay}"
                                Emoji="&#x1F4DA;"
                                Visibility="{x:Bind ViewModel.ShowEmptyHolder, Mode=OneWay}"/>

        <!--  加载动画  -->
        <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</UserControl>
