<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.User.UserSideSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:animations="using:CommunityToolkit.WinUI.Animations"
             xmlns:cvt="using:PhoenixReadCopilot.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="using:FluentIcons.WinUI"
             xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
             xmlns:local="using:PhoenixReadCopilot.Controls.User"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             mc:Ignorable="d">

    <Grid Margin="12,4,12,12">
        <ItemsView x:Name="SectionView"
                   ItemsSource="{x:Bind ViewModel.Sections, Mode=OneWay}"
                   ScrollViewer.HorizontalScrollMode="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   SelectionChanged="OnSectionSelectionChanged"
                   SelectionMode="Single">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="items:UserSpaceSectionItemViewModel">
                    <ItemContainer Height="40"
                                   Margin="0,2"
                                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                   Style="{StaticResource AppItemContainerStyle}">
                        <Grid Padding="12,0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ic:SymbolIcon VerticalAlignment="Center"
                                           FontSize="16"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Symbol="{x:Bind Symbol, Mode=OneWay}"/>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{x:Bind Title, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"/>

                            <!--  数量徽章 (仅在大于0时显示)  -->
                            <Border Grid.Column="2"
                                    Padding="6,1"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="8"
                                    Visibility="{x:Bind HasCount, Mode=OneWay}">
                                <TextBlock FontSize="10"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="{x:Bind cvt:Converter.LongCountToText(Count), Mode=OneWay}"/>
                            </Border>
                        </Grid>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
            <ItemsView.Layout>
                <StackLayout Spacing="4"/>
            </ItemsView.Layout>
        </ItemsView>

        <animations:Implicit.ShowAnimations>
            <animations:TranslationAnimation From="-20,0"
                                             To="0,0"
                                             Duration="0:0:0.24"/>
            <animations:OpacityAnimation From="0.0"
                                         To="1.0"
                                         Duration="0:0:0.2"/>
        </animations:Implicit.ShowAnimations>
    </Grid>
</UserControl>
