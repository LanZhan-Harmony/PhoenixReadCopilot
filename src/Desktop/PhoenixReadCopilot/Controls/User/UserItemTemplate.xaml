<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="PhoenixReadCopilot.Controls.User.UserItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:WinUIKernel.Share.Base"
                    xmlns:community="using:CommunityToolkit.WinUI.Controls"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                    xmlns:strings="using:PhoenixReadCopilot.Strings">

    <DataTemplate x:Key="UserItemTemplate" x:DataType="items:UserItemViewModel">
        <Button Padding="10,0"
                Command="{x:Bind ShowUserSpaceCommand}"
                DataContext="{x:Bind}"
                Style="{StaticResource GridRepeaterItemStyle}">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PersonPicture Grid.Column="0"
                               Width="48"
                               Height="48"
                               DisplayName="{x:Bind Name}">
                    <PersonPicture.ProfilePicture>
                        <BitmapImage DecodePixelType="Logical"
                                     DecodePixelWidth="48"
                                     UriSource="{x:Bind Avatar}"/>
                    </PersonPicture.ProfilePicture>
                </PersonPicture>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           MaxLines="3"
                           Text="{x:Bind Name}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap"/>
                <ToggleButton x:Name="FollowButton"
                              Grid.Column="2"
                              Width="40"
                              Height="30"
                              Padding="0"
                              VerticalAlignment="Center"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              Command="{x:Bind ToggleFollowCommand}"
                              CornerRadius="4">
                    <ic:SymbolIcon x:Name="FollowIcon"
                                   FontSize="16"
                                   Symbol="Heart"
                                   ToolTipService.ToolTip="{x:Bind strings:Resources.Follow}"/>
                </ToggleButton>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
