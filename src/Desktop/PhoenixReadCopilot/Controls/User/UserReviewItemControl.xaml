<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.User.UserReviewItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:api="using:PhoenixReadApi"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="using:FluentIcons.WinUI"
             xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Border Margin="0,0,0,8"
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource ControlCornerRadius}">
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--  短剧海报封面 (带点击看剧按钮)  -->
            <Button Padding="0"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.PlayDramaCommand, Mode=OneWay}"
                    CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid Width="72" Height="100">
                    <Image Source="{x:Bind ViewModel.DramaCoverUrl, Mode=OneWay, Converter={StaticResource BitmapConverter}}" Stretch="UniformToFill"/>
                </Grid>
            </Button>

            <!--  剧评内容区域  -->
            <StackPanel Grid.Column="1" Spacing="8">
                <!--  顶部: 短剧标题、评分、文案与时间  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Text="{x:Bind ViewModel.DramaTitle, Mode=OneWay}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!--  评分徽章  -->
                        <Border Padding="6,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4">
                            <TextBlock FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Text="{x:Bind ViewModel.Rating, Mode=OneWay}"/>
                        </Border>

                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="{x:Bind ViewModel.RatingText, Mode=OneWay}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Text="{x:Bind ViewModel.PublishTime, Mode=OneWay}"/>
                </Grid>

                <!--  剧评正文  -->
                <TextBlock FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           IsTextSelectionEnabled="True"
                           Text="{x:Bind ViewModel.Content, Mode=OneWay}"
                           TextWrapping="Wrap"/>

                <!--  附带配图 (若有)  -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}" Visibility="{x:Bind ViewModel.HasImages, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="api:CommentImage">
                            <Border Width="60"
                                    Height="60"
                                    CornerRadius="4">
                                <Image Source="{x:Bind Url, Converter={StaticResource BitmapConverter}}" Stretch="UniformToFill"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--  底部数据: 获赞与回复  -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:SymbolIcon FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Symbol="ThumbLike"/>
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{x:Bind ViewModel.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:SymbolIcon FontSize="12"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       Symbol="Comment"/>
                        <TextBlock FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Text="{x:Bind ViewModel.ReplyCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
