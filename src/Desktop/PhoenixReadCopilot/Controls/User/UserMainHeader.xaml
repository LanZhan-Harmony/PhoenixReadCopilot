<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.User.UserMainHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ic="using:FluentIcons.WinUI"
             xmlns:local="using:PhoenixReadCopilot.Controls.User"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:PhoenixReadCopilot.Strings"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             mc:Ignorable="d">

    <Grid Padding="16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!--  当前选中的 Section 标题  -->
        <TextBlock VerticalAlignment="Center"
                   FontWeight="SemiBold"
                   Style="{StaticResource SubtitleTextBlockStyle}"
                   Text="{x:Bind ViewModel.SelectedSection.Title, Mode=OneWay}"/>

        <!--  中间子分类 SelectorBar  -->
        <SelectorBar x:Name="SubTabSelector"
                     Grid.Column="1"
                     Margin="24,0"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     SelectionChanged="OnSubTabSelectionChanged"
                     Visibility="{x:Bind ViewModel.SelectedSection.HasSubTabs, Mode=OneWay}"/>

        <!--  右侧操作区: 刷新按钮  -->
        <StackPanel Grid.Column="2"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
            <Button AutomationProperties.Name="{x:Bind strings:Resources.Refresh}" Command="{x:Bind ViewModel.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <ic:SymbolIcon VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                   Symbol="ArrowSync"/>
                    <TextBlock VerticalAlignment="Center" Text="{x:Bind strings:Resources.Refresh}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
