<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase x:Class="PhoenixReadCopilot.Controls.Settings.DownloadSettingControl"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:community="using:CommunityToolkit.WinUI.Controls"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:ic="using:FluentIcons.WinUI"
                               xmlns:local="using:PhoenixReadCopilot.Controls.Settings"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:strings="using:PhoenixReadCopilot.Strings"
                               mc:Ignorable="d">

    <community:SettingsExpander Description="{x:Bind strings:Resources.DownloadSettingDescription}" Header="{x:Bind strings:Resources.DownloadSetting}">
        <community:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="ArrowDownload"/>
        </community:SettingsExpander.HeaderIcon>
        <community:SettingsExpander.Items>
            <community:SettingsCard Description="{x:Bind ViewModel.Settings.DownloadFolder, Mode=OneWay}" Header="{x:Bind strings:Resources.DefaultDownloadFolder}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button MinWidth="120"
                            VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.ChooseDownloadFolderCommand, Mode=OneWay}"
                            Content="{x:Bind strings:Resources.ChooseDownloadFolder}"/>
                    <Button VerticalAlignment="Center"
                            Command="{x:Bind ViewModel.OpenDownloadFolderCommand}"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind strings:Resources.OpenFolder}">
                        <ic:SymbolIcon FontSize="14" Symbol="FolderOpen"/>
                    </Button>
                </StackPanel>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.DownloadWithDanmaku}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.DownloadWithDanmaku, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.SkipAISubtitle}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.FilterAISubtitle, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.OpenFolderWhenDownloaded}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.OpenFolderAfterDownload, Mode=TwoWay}"/>
            </community:SettingsCard>
        </community:SettingsExpander.Items>
    </community:SettingsExpander>
</local:SettingsPageControlBase>
