<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Settings.PlayerBehaviorSettingControl"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:community="using:CommunityToolkit.WinUI.Controls"
                               xmlns:constants="using:PhoenixReadCopilot.Core.Enums"
                               xmlns:cvt="using:PhoenixReadCopilot.Converters"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:essential="using:WinUI3Package"
                               xmlns:ic="using:FluentIcons.WinUI"
                               xmlns:local="using:PhoenixReadCopilot.Controls.Settings"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:strings="using:PhoenixReadCopilot.Strings"
                               mc:Ignorable="d">

    <community:SettingsExpander Description="{x:Bind strings:Resources.PlayerBehaviorDescription}" Header="{x:Bind strings:Resources.PlayerBehavior}">
        <community:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="Replay"/>
        </community:SettingsExpander.HeaderIcon>
        <community:SettingsExpander.Items>
            <community:SettingsCard Description="{x:Bind strings:Resources.PlayerTypeDescription}" Header="{x:Bind strings:Resources.PlayerType}">
                <ComboBox MinWidth="120"
                          essential:ComboBoxHelper.AcrylicWorkaround="True"
                          ItemsSource="{x:Bind ViewModel.PlayerTypeCollection, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.Settings.PlayerType, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PlayerType">
                            <TextBlock Text="{x:Bind cvt:Converter.PlayerTypeToText((constants:PlayerType))}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.PreferQuality}">
                <ComboBox MinWidth="120"
                          essential:ComboBoxHelper.AcrylicWorkaround="True"
                          ItemsSource="{x:Bind ViewModel.PreferQualityCollection, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.Settings.PreferQuality, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferQualityType">
                            <TextBlock Text="{x:Bind cvt:Converter.PreferQualityToText((constants:PreferQualityType))}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.DefaultPlayerDisplayMode}">
                <ComboBox MinWidth="120"
                          essential:ComboBoxHelper.AcrylicWorkaround="True"
                          ItemsSource="{x:Bind ViewModel.PlayerDisplayModeCollection, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.Settings.DefaultPlayerDisplayMode, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PlayerDisplayMode">
                            <TextBlock Text="{x:Bind cvt:Converter.DisplayModeToText((constants:PlayerDisplayMode))}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.AutoPlayWhenLoaded}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.ShouldAutoPlay, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.AutoLoadHistoryWhenLoaded}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.AutoLoadHistory, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.AutoNextRelatedVideoDescription}" Header="{x:Bind strings:Resources.AutoNextRelatedVideo}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.AutoPlayNextRecommendVideo, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.ContinuousPlayDescription}" Header="{x:Bind strings:Resources.ContinuousPlay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.AutoPlayNext, Mode=TwoWay}"/>
            </community:SettingsCard>
        </community:SettingsExpander.Items>
    </community:SettingsExpander>
</UserControl>
