<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Settings.PlayerControlSettingControl"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:community="using:CommunityToolkit.WinUI.Controls"
                               xmlns:constants="using:PhoenixReadCopilot.Core.Enums"
                               xmlns:cvt="using:PhoenixReadCopilot.Converters"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:essential="using:WinUI3Package"
                               xmlns:ic="using:FluentIcons.WinUI"
                               xmlns:local="using:PhoenixReadCopilot.Controls.Settings"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:strings="using:PhoenixReadCopilot.Strings"
                               mc:Ignorable="d">

    <community:SettingsExpander Description="{x:Bind strings:Resources.PlayerControlDescription}" Header="{x:Bind strings:Resources.PlayerControl}">
        <community:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="VideoPlayPause"/>
        </community:SettingsExpander.HeaderIcon>
        <community:SettingsExpander.Items>
            <community:SettingsCard Description="{x:Bind strings:Resources.MTCBehaviorDescription}" Header="{x:Bind strings:Resources.MTCBehavior}">
                <ComboBox MinWidth="120"
                          essential:ComboBoxHelper.AcrylicWorkaround="True"
                          ItemsSource="{x:Bind ViewModel.MTCBehaviorCollection, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.Settings.MTCBehavior, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:MTCBehavior">
                            <TextBlock Text="{x:Bind cvt:Converter.MTCBehaviorToText((constants:MTCBehavior))}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.PreferCodecDescription}" Header="{x:Bind strings:Resources.PreferCodec}">
                <ComboBox MinWidth="120"
                          essential:ComboBoxHelper.AcrylicWorkaround="True"
                          ItemsSource="{x:Bind ViewModel.PreferCodecCollection, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.Settings.PreferCodec, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferCodecType">
                            <TextBlock Text="{x:Bind cvt:Converter.PreferCodecToText((constants:PreferCodecType))}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.SingleFastForwardAndRewindSpanDescription}" Header="{x:Bind strings:Resources.SingleFastForwardAndRewindSpan}">
                <NumberBox MinWidth="120"
                           essential:NumberBoxHelper.AcrylicWorkaround="True"
                           LargeChange="50"
                           Maximum="300"
                           Minimum="3"
                           SmallChange="10"
                           SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ViewModel.Settings.SingleFastForwardAndRewindSpan, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.GlobalPlaybackRateDescription}" Header="{x:Bind strings:Resources.GlobalPlaybackRate}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.IsPlayerSpeedShare, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.PlaybackRateEnhancementDescription}" Header="{x:Bind strings:Resources.PlaybackRateEnhancement}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.IsPlayerSpeedEnhancement, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.BottomProgressVisibleDescription}" Header="{x:Bind strings:Resources.BottomProgressVisible}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.Settings.IsBottomProgressVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
        </community:SettingsExpander.Items>
    </community:SettingsExpander>
</UserControl>
