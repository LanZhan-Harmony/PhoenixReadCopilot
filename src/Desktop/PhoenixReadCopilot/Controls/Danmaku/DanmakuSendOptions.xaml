<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Danmaku.DanmakuSendOptions"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:cvt="using:PhoenixReadCopilot.Converters"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:enums="using:PhoenixReadCopilot.Core.Enums"
                          xmlns:essential="using:WinUI3Package"
                          xmlns:local="using:PhoenixReadCopilot.Controls.Danmaku"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.Strings"
                          mc:Ignorable="d">

    <StackPanel Width="240"
                Padding="8,4"
                Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Bind strings:Resources.FontSize}"/>
            <StackPanel HorizontalAlignment="Left"
                        Orientation="Horizontal"
                        Spacing="16">
                <RadioButton x:Name="StandardItem"
                             MinWidth="0"
                             Click="OnSizeItemClick"
                             Content="{x:Bind strings:Resources.Standard}"
                             IsChecked="{x:Bind ViewModel.IsStandardSize, Mode=OneWay}"
                             Tag="Standard"/>
                <RadioButton x:Name="SmallItem"
                             MinWidth="0"
                             Click="OnSizeItemClick"
                             Content="{x:Bind strings:Resources.Small}"
                             IsChecked="{x:Bind cvt:Converter.InvertBool(ViewModel.IsStandardSize), Mode=OneWay}"
                             Tag="Small"/>
            </StackPanel>
        </StackPanel>
        <ComboBox x:Name="DanmakuLocationComboBox"
                  HorizontalAlignment="Stretch"
                  essential:ComboBoxHelper.AcrylicWorkaround="True"
                  Header="{x:Bind strings:Resources.Location}"
                  ItemsSource="{x:Bind ViewModel.Locations, Mode=OneWay}"
                  SelectedItem="{x:Bind ViewModel.Location, Mode=TwoWay}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="enums:DanmakuLocation">
                    <TextBlock Text="{x:Bind cvt:Converter.DanmakuLocationToText((enums:DanmakuLocation))}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <StackPanel Spacing="12">
            <TextBlock Text="{x:Bind strings:Resources.Color}"/>
            <Grid Margin="0,-4,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         IsReadOnly="True"
                         Text="{x:Bind cvt:Converter.ColorToText(ViewModel.Color), Mode=OneWay}"/>
                <Rectangle Grid.Column="1"
                           Width="80"
                           Fill="{x:Bind cvt:Converter.ColorToBrush(ViewModel.Color), Mode=OneWay}"
                           RadiusX="4"
                           RadiusY="4"/>
            </Grid>
            <ItemsRepeater x:Name="ColorRepeater"
                           HorizontalAlignment="Stretch"
                           ItemsSource="{x:Bind ViewModel.Colors, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout ItemsStretch="Fill"
                                       MinColumnSpacing="8"
                                       MinItemHeight="32"
                                       MinItemWidth="32"
                                       MinRowSpacing="8"/>
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="Color">
                        <Rectangle HorizontalAlignment="Stretch"
                                   VerticalAlignment="Stretch"
                                   DataContext="{x:Bind}"
                                   Fill="{x:Bind cvt:Converter.ColorToBrush((Color))}"
                                   RadiusX="4"
                                   RadiusY="4"
                                   Tapped="OnColorItemTapped"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </StackPanel>
</UserControl>
