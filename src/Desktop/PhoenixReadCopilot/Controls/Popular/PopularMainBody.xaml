<?xml version="1.0" encoding="utf-8" ?>
<local:PopularPageControlBase x:Class="PhoenixReadCopilot.Controls.Popular.PopularMainBody"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:base="using:WinUIKernel.Share.Base"
                              xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                              xmlns:local="using:PhoenixReadCopilot.Controls.Popular"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:strings="using:PhoenixReadCopilot.Strings"
                              mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="VideoScrollView" Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="16,12">
                <!-- 短剧排行榜列表 (独立呈现，未来可独立更换为 StaggeredLayout) -->
                <ItemsRepeater x:Name="DramaRepeater"
                               ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                               Layout="{StaticResource VideoLayout}"
                               Visibility="{x:Bind ViewModel.IsActorLeaderboard, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:VideoItemViewModel">
                            <components:VideoCardControl Style="{StaticResource RankVideoCardStyle}" ViewModel="{x:Bind Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <!-- 演员排行榜列表 (独立呈现，一行一个演员) -->
                <ItemsRepeater x:Name="ActorRepeater"
                               ItemsSource="{x:Bind ViewModel.Actors, Mode=OneWay}"
                               Visibility="{x:Bind ViewModel.IsActorLeaderboard, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="10"/>
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:ActorItemViewModel">
                            <local:ActorRankCardControl ViewModel="{x:Bind Mode=OneWay}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}"/>
    </Grid>
</local:PopularPageControlBase>
