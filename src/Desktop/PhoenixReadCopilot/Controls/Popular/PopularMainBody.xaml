<?xml version="1.0" encoding="utf-8" ?>
<local:PopularPageControlBase x:Class="PhoenixReadCopilot.Controls.Popular.PopularMainBody"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:base="using:WinUIKernel.Share.Base"
                              xmlns:community="using:CommunityToolkit.WinUI.Controls"
                              xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:ext="using:PhoenixReadCopilot.Extensions"
                              xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                              xmlns:local="using:PhoenixReadCopilot.Controls.Popular"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:strings="using:PhoenixReadCopilot.Strings"
                              mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="RecommendStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource RecommendVideoCardStyle}" ViewModel="{x:Bind Mode=OneWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="HotStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource HotVideoCardStyle}" ViewModel="{x:Bind Mode=OneWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="RankStyle" x:DataType="items:VideoItemViewModel">
            <components:VideoCardControl Style="{StaticResource RankVideoCardStyle}" ViewModel="{x:Bind Mode=OneWay}"/>
        </DataTemplate>
        <DataTemplate x:Key="ActorStyle" x:DataType="items:VideoItemViewModel">
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="16,14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    Command="{x:Bind ShowUserSpaceCommand, Mode=OneWay}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Margin="4,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind RankDisplay, Mode=OneWay}"
                                   Foreground="#FA8C16"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Visibility="{x:Bind IsTopRank, Mode=OneWay}"/>
                        <TextBlock Text="{x:Bind RankDisplay, Mode=OneWay}"
                                   Foreground="#8C8C8C"
                                   FontWeight="Bold"
                                   FontStyle="Italic"
                                   FontSize="22"
                                   HorizontalAlignment="Center"
                                   Visibility="{x:Bind IsTopRank, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
                    </Grid>
                    <PersonPicture Grid.Column="1"
                                   Width="58"
                                   Height="58"
                                   ProfilePicture="{x:Bind Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"
                                   DisplayName="{x:Bind Title, Mode=OneWay}"
                                   VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2"
                                Margin="18,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="4">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ActorSubtitles, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{x:Bind ActorRepresentativeWork, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="&#x2665;"
                                       FontSize="12"
                                       Foreground="#FF3B30"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ActorPopularity, Mode=OneWay}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#FF3B30"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
        <ext:VideoCardTemplateSelector x:Key="CardSelector"
                                       ActorTemplate="{StaticResource ActorStyle}"
                                       HotTemplate="{StaticResource HotStyle}"
                                       RankTemplate="{StaticResource RankStyle}"
                                       RecommendTemplate="{StaticResource RecommendStyle}"/>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="VideoScrollView" Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="16,12">
                <ItemsRepeater x:Name="VideoRepeater"
                               ItemsSource="{x:Bind ViewModel.Videos}"
                               ItemTemplate="{StaticResource CardSelector}"
                               Layout="{StaticResource VideoLayout}"/>
            </Grid>
        </ScrollViewer>
        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}"/>
    </Grid>
</local:PopularPageControlBase>
