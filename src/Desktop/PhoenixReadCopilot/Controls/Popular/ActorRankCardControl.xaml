<?xml version="1.0" encoding="utf-8" ?>
<local:ActorRankCardControlBase x:Class="PhoenixReadCopilot.Controls.Popular.ActorRankCardControl"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:base="using:WinUIKernel.Share.Base"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:ic="using:FluentIcons.WinUI"
                                xmlns:local="using:PhoenixReadCopilot.Controls.Popular"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                mc:Ignorable="d">

    <base:CardControl HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Padding="16,14"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="{StaticResource ControlCornerRadius}"
                      Command="{x:Bind ViewModel.ShowUserSpaceCommand, Mode=OneWay}">
        <Grid ColumnSpacing="16" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 0: 排名徽章与升降趋势 -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 冠军金牌 -->
                <Border Width="36" Height="26" CornerRadius="6"
                        Background="#FFB800"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsRank1, Mode=OneWay}">
                    <TextBlock Text="1" FontWeight="Bold" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 亚军银牌 -->
                <Border Width="36" Height="26" CornerRadius="6"
                        Background="#94A3B8"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsRank2, Mode=OneWay}">
                    <TextBlock Text="2" FontWeight="Bold" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 季军铜牌 -->
                <Border Width="36" Height="26" CornerRadius="6"
                        Background="#D97706"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsRank3, Mode=OneWay}">
                    <TextBlock Text="3" FontWeight="Bold" FontSize="15" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 4+ 名 -->
                <Border Width="36" Height="26" CornerRadius="6"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind ViewModel.IsTopRank, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <TextBlock Text="{x:Bind ViewModel.RankDisplay, Mode=OneWay}"
                               FontWeight="SemiBold" FontSize="14"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- 排名升降趋势 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0" Spacing="2">
                    <!-- 上升 -->
                    <StackPanel Orientation="Horizontal" Spacing="1"
                                Visibility="{x:Bind ViewModel.IsRankUp, Mode=OneWay}">
                        <ic:SymbolIcon Symbol="ArrowUp" FontSize="10" Foreground="#10B981" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.RankChangeValueText, Mode=OneWay}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#10B981" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 下降 -->
                    <StackPanel Orientation="Horizontal" Spacing="1"
                                Visibility="{x:Bind ViewModel.IsRankDown, Mode=OneWay}">
                        <ic:SymbolIcon Symbol="ArrowDown" FontSize="10" Foreground="#EF4444" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.RankChangeValueText, Mode=OneWay}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#EF4444" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 持平 -->
                    <TextBlock Text="—"
                               FontSize="11" FontWeight="Medium"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="{x:Bind ViewModel.IsRankSame, Mode=OneWay}"/>
                </StackPanel>
            </StackPanel>

            <!-- 1: 演员头像 -->
            <PersonPicture Grid.Column="1"
                           Width="58"
                           Height="58"
                           ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"
                           DisplayName="{x:Bind ViewModel.Name, Mode=OneWay}"
                           VerticalAlignment="Center"/>

            <!-- 2: 核心信息 -->
            <StackPanel Grid.Column="2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="6">
                <!-- 姓名与代表作 -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasRepresentativeWork, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <ic:SymbolIcon Symbol="MoviesAndTv"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                           VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.RepresentativeWorkDisplay, Mode=OneWay}"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       MaxWidth="320"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 副标题/标签 -->
                <TextBlock Text="{x:Bind ViewModel.Subtitles, Mode=OneWay}"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           Visibility="{x:Bind ViewModel.HasSubtitles, Mode=OneWay}"/>
            </StackPanel>

            <!-- 3: 热度与箭头指示 -->
            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="12"
                        VerticalAlignment="Center">
                <!-- 人气胶囊 -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="10,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ic:SymbolIcon Symbol="Fire"
                                       FontSize="14"
                                       Foreground="#FF5722"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.Popularity, Mode=OneWay}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#FF5722"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- 前往主页指示图标 -->
                <ic:SymbolIcon Symbol="ChevronRight"
                               FontSize="14"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </base:CardControl>
</local:ActorRankCardControlBase>
