<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Components.EmptyHolder"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:cvt="using:PhoenixReadCopilot.Converters"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            mc:Ignorable="d">

    <StackPanel Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
        <FontIcon Margin="0,0,0,12"
                  HorizontalAlignment="Center"
                  FontFamily="Segoe UI Emoji"
                  FontSize="40"
                  Glyph="{x:Bind Emoji, Mode=OneWay}"
                  Visibility="{x:Bind cvt:Converter.StringToVisibility(Emoji), Mode=OneWay}"/>
        <TextBlock Margin="0,0,0,8"
                   HorizontalAlignment="Center"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Text="{x:Bind Title, Mode=OneWay}"
                   TextAlignment="Center"
                   Visibility="{x:Bind cvt:Converter.StringToVisibility(Title), Mode=OneWay}"/>
        <TextBlock MaxWidth="164"
                   HorizontalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   LineHeight="20"
                   MaxLines="5"
                   Style="{StaticResource CaptionTextBlockStyle}"
                   Text="{x:Bind Description, Mode=OneWay}"
                   TextAlignment="Center"
                   Visibility="{x:Bind cvt:Converter.StringToVisibility(Description), Mode=OneWay}"/>
        <ContentPresenter Margin="0,8,0,0"
                          HorizontalAlignment="Center"
                          Content="{x:Bind ActionElement, Mode=OneWay}"
                          Visibility="{x:Bind cvt:Converter.ObjectToVisibility(ActionElement), Mode=OneWay}"/>
    </StackPanel>
</UserControl>
