<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.Controls.Components.CalendarVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="96"/>
        </Grid.RowDefinitions>

        <!--  海报封面容器  -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4,4,0,0">
            <Image HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Stretch="UniformToFill">
                <Image.Source>
                    <BitmapImage DecodePixelType="Logical"
                                 DecodePixelWidth="300"
                                 UriSource="{x:Bind ViewModel.Cover, Mode=OneWay}"/>
                </Image.Source>
            </Image>
        </Border>

        <!--  左上角：已上线状态徽章  -->
        <Border Grid.Row="0"
                Margin="4"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.IsOnline, Mode=OneWay}">
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                       Text="{x:Bind strings:Resources.Online}"/>
        </Border>

        <!--  左上角：未上线 / 待播说明徽章  -->
        <Border Grid.Row="0"
                Margin="4"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#B0000000"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.IsOnline, Converter={StaticResource BoolToVisibilityReverseConverter}, Mode=OneWay}">
            <TextBlock FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="White"
                       Text="{x:Bind ViewModel.OnlineStatusText, Mode=OneWay}"/>
        </Border>

        <!--  左下角：集数  -->
        <Border Grid.Row="0"
                Margin="4"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#99000000"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasEpisodeCount, Mode=OneWay}">
            <TextBlock FontSize="11"
                       Foreground="White"
                       Text="{x:Bind ViewModel.EpisodeCountText, Mode=OneWay}"/>
        </Border>

        <!--  右下角：评分徽章  -->
        <Border Grid.Row="0"
                Margin="4"
                Padding="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#B0D32F2F"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasScore, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock FontSize="11"
                           FontWeight="Bold"
                           Foreground="Gold"
                           Text="{x:Bind ViewModel.Score, Mode=OneWay}"/>
                <ic:SymbolIcon FontSize="11"
                               Foreground="Gold"
                               IconVariant="Filled"
                               Symbol="Star"/>
            </StackPanel>
        </Border>

        <!--  信息与操作区域  -->
        <Grid Grid.Row="1"
              Padding="10,6,10,8"
              RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--  标题  -->
            <TextBlock Grid.Row="0"
                       FontWeight="SemiBold"
                       MaxLines="1"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       ToolTipService.ToolTip="{x:Bind ViewModel.Title, Mode=OneWay}"/>

            <!--  题材分类 / 上线说明  -->
            <base:IconTextBlock Grid.Row="1"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                Symbol="Tag"
                                Text="{x:Bind ViewModel.Author, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind ViewModel.Author, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>

            <!--  操作按钮区  -->
            <Grid Grid.Row="2" VerticalAlignment="Bottom">
                <!--  已上线：立即观看  -->
                <Button HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.PlayCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsOnline, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ic:SymbolIcon FontSize="13"
                                       IconVariant="Filled"
                                       Symbol="Play"/>
                        <TextBlock FontSize="12" Text="{x:Bind strings:Resources.PlayNow}"/>
                    </StackPanel>
                </Button>

                <!--  未上线：预约控制区  -->
                <Grid Visibility="{x:Bind ViewModel.IsOnline, Converter={StaticResource BoolToVisibilityReverseConverter}, Mode=OneWay}">
                    <!--  未预约状态：显示“预约”  -->
                    <Button HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ToggleReservationCommand}"
                            IsEnabled="{x:Bind ViewModel.IsReserving, Converter={StaticResource ObjectToBoolReverseConverter}, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}"
                            Visibility="{x:Bind ViewModel.IsReserved, Converter={StaticResource BoolToVisibilityReverseConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon FontSize="13" Symbol="CalendarClock"/>
                            <TextBlock FontSize="12" Text="{x:Bind strings:Resources.Reserve}"/>
                        </StackPanel>
                    </Button>

                    <!--  已预约状态：显示“已预约”  -->
                    <Button Padding="0,3"
                            HorizontalAlignment="Stretch"
                            Command="{x:Bind ViewModel.ToggleReservationCommand}"
                            IsEnabled="{x:Bind ViewModel.IsReserving, Converter={StaticResource ObjectToBoolReverseConverter}, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsReserved, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ic:SymbolIcon FontSize="13"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                           Symbol="CheckmarkCircle"/>
                            <TextBlock FontSize="12" Text="{x:Bind strings:Resources.Reserved}"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</local:VideoCardPresenter>