<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.Controls.Components.RankVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="85"/>
        </Grid.RowDefinitions>
        <local:VideoCoverImage CornerRadius="4,4,0,0" Source="{x:Bind ViewModel.Cover, Mode=OneWay}"/>

        <!--  左上角：排名徽章  -->
        <Border Margin="4"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasRank, Mode=OneWay}">
            <TextBlock FontSize="11"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="{x:Bind ViewModel.RankText, Mode=OneWay}"/>
        </Border>

        <!--  右上角：评分徽章  -->
        <Border Margin="4"
                Padding="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#B0D32F2F"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasScore, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <TextBlock FontWeight="Bold"
                           Foreground="Gold"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.Score, Mode=OneWay}"/>
                <ic:SymbolIcon FontSize="{StaticResource CaptionTextBlockFontSize}"
                               Foreground="Gold"
                               IconVariant="Filled"
                               Symbol="Star"/>
            </StackPanel>
        </Border>

        <!--  信息与元数据  -->
        <Grid Grid.Row="1"
              Padding="12,8,12,12"
              RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!--  标题  -->
            <TextBlock Grid.Row="0"
                       HorizontalAlignment="Left"
                       MaxLines="2"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"/>

            <!--  底部行：题材分类 / 热度播放量  -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!--  标签  -->
                <base:IconTextBlock Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                    Symbol="Tag"
                                    Text="{x:Bind ViewModel.TagName, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.TagName, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                <!--  热度或播放量  -->
                <base:IconTextBlock Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="PlayCircle"
                                    Text="{x:Bind ViewModel.HeatOrPlayCountText, Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"
                                    Visibility="{x:Bind ViewModel.HeatOrPlayCountText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
            </Grid>
        </Grid>
    </Grid>
</local:VideoCardPresenter>
