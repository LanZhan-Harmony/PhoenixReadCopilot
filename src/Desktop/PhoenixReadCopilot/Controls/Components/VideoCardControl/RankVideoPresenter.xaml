<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.Controls.Components.RankVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="102"/>
        </Grid.RowDefinitions>
        <local:VideoCoverImage CornerRadius="4,4,0,0" Source="{x:Bind ViewModel.Cover, Mode=OneWay}"/>

        <!--  排名徽章  -->
        <Border Margin="6"
                Padding="6,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasRank, Mode=OneWay}">
            <TextBlock FontSize="11"
                       FontWeight="Bold"
                       Foreground="White"
                       Text="{x:Bind ViewModel.RankText, Mode=OneWay}"/>
        </Border>

        <!--  评分徽章  -->
        <Border Margin="6"
                Padding="6,2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Background="#B0D32F2F"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasScore, Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <TextBlock FontWeight="Bold"
                           Foreground="Gold"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="★"/>
                <TextBlock FontWeight="Bold"
                           Foreground="White"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.Score, Mode=OneWay}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1"
              Padding="12,8,12,12"
              RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           MaxLines="1"
                           Text="{x:Bind ViewModel.Author, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.PublishRelativeTime, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Visibility="{x:Bind ViewModel.PublishRelativeTime, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
            </Grid>
            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Left"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           MaxLines="1"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.TagName, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                    <ic:SymbolIcon VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                                   Symbol="Fire"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="10"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind ViewModel.HeatOrPlayCountText, Mode=OneWay}"
                               TextLineBounds="Tight"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</local:VideoCardPresenter>
