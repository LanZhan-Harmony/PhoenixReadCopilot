<?xml version="1.0" encoding="utf-8" ?>
<ctrl:LayoutUserControlBase x:Class="PhoenixReadCopilot.Controls.Components.SideSplitButton"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:ctrl="using:PhoenixReadCopilot.Controls"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:ic="using:FluentIcons.WinUI"
                            xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            mc:Ignorable="d">

    <Button Width="36"
            Height="36"
            Padding="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="OnBtnClick">
        <ic:SymbolIcon x:Name="SymbolControl"
                       FontSize="14"
                       IconVariant="Filled"/>
    </Button>
</ctrl:LayoutUserControlBase>
