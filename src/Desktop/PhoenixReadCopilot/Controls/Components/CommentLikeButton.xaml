<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PhoenixReadCopilot.Controls.Components.CommentLikeButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="using:PhoenixReadCopilot.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.Controls.Components"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ToggleButton
        x:Name="LikeButton"
        VerticalAlignment="Center"
        Command="{x:Bind ViewModel.ToggleLikeCommand, Mode=OneWay}"
        IsChecked="{x:Bind ViewModel.IsLiked, Mode=OneWay}">
        <StackPanel Orientation="Horizontal"
                Spacing="8">
            <ic:SymbolIcon
                VerticalAlignment="Center"
                FontSize="12"
                IconVariant="{x:Bind cvt:Converter.BoolToIconVariant(ViewModel.IsLiked), Mode=OneWay}"
                Symbol="ThumbLike"/>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Text="{x:Bind cvt:Converter.CountToText(ViewModel.LikeCount), Mode=OneWay}"/>
        </StackPanel>
    </ToggleButton>
</UserControl>
