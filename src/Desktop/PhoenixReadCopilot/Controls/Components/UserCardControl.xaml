<?xml version="1.0" encoding="utf-8" ?>
<local:UserCardControlBase x:Class="PhoenixReadCopilot.Controls.Components.UserCardControl"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:base="using:WinUIKernel.Share.Base"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:ic="using:FluentIcons.WinUI"
                           xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:strings="using:PhoenixReadCopilot.Strings"
                           mc:Ignorable="d">

    <base:CardControl x:Name="RootCard"
                      BorderThickness="0"
                      Command="{x:Bind ViewModel.ShowUserSpaceCommand, Mode=OneWay}">
        <Grid Padding="12" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PersonPicture Grid.Column="0"
                           Width="48"
                           Height="48"
                           DisplayName="{x:Bind ViewModel.Name, Mode=OneWay}"
                           ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontWeight="Bold"
                       MaxLines="3"
                       Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"/>
            <ToggleButton x:Name="FollowButton"
                          Grid.Column="2"
                          Width="40"
                          Height="30"
                          Padding="0"
                          VerticalAlignment="Center"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          Command="{x:Bind ViewModel.ToggleFollowCommand, Mode=OneWay}"
                          CornerRadius="4">
                <ic:SymbolIcon x:Name="FollowIcon"
                               FontSize="16"
                               Symbol="Heart"
                               ToolTipService.ToolTip="{x:Bind strings:Resources.Follow}"/>
            </ToggleButton>

        </Grid>
    </base:CardControl>
</local:UserCardControlBase>
