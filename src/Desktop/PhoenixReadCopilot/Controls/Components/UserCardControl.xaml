<?xml version="1.0" encoding="utf-8" ?>
<local:UserCardControlBase x:Class="PhoenixReadCopilot.Controls.Components.UserCardControl"
                           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                           xmlns:base="using:WinUIKernel.Share.Base"
                           xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                           xmlns:ic="using:FluentIcons.WinUI"
                           xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                           xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                           xmlns:strings="using:PhoenixReadCopilot.Strings"
                           mc:Ignorable="d">

    <base:CardControl x:Name="RootCard"
                      BorderThickness="0"
                      Command="{x:Bind ViewModel.ShowUserSpaceCommand, Mode=OneWay}">
        <Grid Padding="12,12,12,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Top">
                <PersonPicture Width="48"
                               Height="48"
                               DisplayName="{x:Bind ViewModel.Name, Mode=OneWay}"
                               ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock FontWeight="Bold"
                               MaxLines="1"
                               Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis"/>
                </Grid>
                <TextBlock Grid.Row="1"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                           TextTrimming="CharacterEllipsis"/>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorDisabledBrush}"
                               IsTextSelectionEnabled="True"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind ViewModel.Id, Mode=OneWay}"/>
                    <ToggleButton x:Name="FollowButton"
                                  Grid.Column="1"
                                  Width="20"
                                  Height="20"
                                  Margin="0,-4,0,0"
                                  Padding="0"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center"
                                  VerticalContentAlignment="Center"
                                  Command="{x:Bind ViewModel.ToggleFollowCommand, Mode=OneWay}"
                                  CornerRadius="10">
                        <ic:SymbolIcon x:Name="FollowIcon"
                                       FontSize="10"
                                       Symbol="Heart"
                                       ToolTipService.ToolTip="{x:Bind strings:Resources.Follow}"/>
                    </ToggleButton>
                </Grid>
            </Grid>
        </Grid>
    </base:CardControl>
</local:UserCardControlBase>
