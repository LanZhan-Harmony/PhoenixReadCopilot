<?xml version="1.0" encoding="utf-8" ?>
<base:LayoutUserControlBase x:Class="PhoenixReadCopilot.Controls.Components.TopNavigationItem"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:base="using:WinUIKernel.Share.Base"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:ic="using:FluentIcons.WinUI"
                            xmlns:local="using:PhoenixReadCopilot.Controls.Components"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            mc:Ignorable="d">

    <Button VerticalAlignment="Center"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Click="OnItemClick"
            Style="{StaticResource IconButtonStyle}">
        <ic:SymbolIcon HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="14"
                       Symbol="{x:Bind Symbol, Mode=OneWay}"/>
    </Button>
</base:LayoutUserControlBase>
