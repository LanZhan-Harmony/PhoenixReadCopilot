<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Components.EmotePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="using:PhoenixReadCopilot.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <ItemsView x:Name="EmoteView"
                   IsItemInvokedEnabled="True"
                   ItemInvoked="OnEmoteViewItemInvoked"
                   ItemsSource="{x:Bind Emojis}"
                   SelectionMode="None">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="helpers:EmojiItem">
                    <ItemContainer Background="Transparent"
                                   Style="{StaticResource AppItemContainerStyle}"
                                   ToolTipService.ToolTip="{x:Bind Name}">
                        <Grid Width="36" Height="36">
                            <Image Width="28"
                                   Height="28"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Source="{x:Bind Uri, Converter={StaticResource BitmapConverter}}"
                                   Stretch="Uniform"/>
                        </Grid>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
            <ItemsView.Layout>
                <UniformGridLayout ItemsStretch="Fill"
                                   MinColumnSpacing="4"
                                   MinItemHeight="38"
                                   MinItemWidth="38"
                                   MinRowSpacing="4"/>
            </ItemsView.Layout>
        </ItemsView>
    </Grid>
</UserControl>
