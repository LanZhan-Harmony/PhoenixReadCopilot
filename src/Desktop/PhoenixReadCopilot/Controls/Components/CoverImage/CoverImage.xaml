<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:local="using:PhoenixReadCopilot.Controls.Components">

    <Style TargetType="local:CoverImage">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:CoverImage">
                    <Grid Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ic:SymbolIcon HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Canvas.ZIndex="0"
                                       FontSize="{TemplateBinding IconSize}"
                                       Foreground="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                       IconVariant="{TemplateBinding IconVarient}"
                                       Symbol="{TemplateBinding Symbol}"/>
                        <Image x:Name="PART_Image"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               Canvas.ZIndex="1"
                               Opacity="0"
                               Stretch="{TemplateBinding Stretch}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>
</ResourceDictionary>
