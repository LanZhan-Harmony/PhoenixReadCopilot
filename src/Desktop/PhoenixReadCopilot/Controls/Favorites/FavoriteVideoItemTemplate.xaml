<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="PhoenixReadCopilot.Controls.Favorites.FavoriteVideoItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:WinUIKernel.Share.Base"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                    xmlns:strings="using:PhoenixReadCopilot.Strings">

    <DataTemplate x:Key="FavoriteVideoItemTemplate" x:DataType="items:VideoItemViewModel">
        <Button Command="{x:Bind PlayCommand}"
                DataContext="{x:Bind}"
                Style="{StaticResource GridRepeaterItemStyle}">
            <Button.ContextFlyout>
                <MenuFlyout ShouldConstrainToRootBounds="False">
                    <MenuFlyoutItem Command="{x:Bind OpenInNewWindowCommand}" Text="{x:Bind strings:Resources.OpenInNewWindow}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="WindowPlay"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind AddToViewLaterCommand}" Text="{x:Bind strings:Resources.AddToViewLater}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="CalendarAdd"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind PinCommand}" Text="{x:Bind strings:Resources.FixContent}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="Pin"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind RemoveFavoriteCommand}" Text="{x:Bind strings:Resources.Remove}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Symbol="Delete"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <Grid x:Name="TemplateContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <!--  海报封面容器  -->
                <components:CoverImage x:Name="CoverImage"
                                       Grid.Row="0"
                                       Margin="6"
                                       CornerRadius="5"
                                       Source="{x:Bind Cover}"/>

                <!--  信息与元数据  -->
                <Grid Grid.Row="1"
                      Padding="10,0,10,8"
                      RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold"
                               MaxLines="2"
                               Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"/>

                    <!--  底部行：添加时间/ 播放量  -->
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--  添加时间  -->
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                            <Run Text="{x:Bind CollectTime}"/>
                            <Run Text="{x:Bind strings:Resources.Add}"/>
                        </TextBlock>

                        <!--  播放量  -->
                        <components:IconTextBlock Grid.Column="1"
                                                  IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                  Symbol="PlayCircle"
                                                  Text="{x:Bind HeatOrPlayCountText}"
                                                  TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                  ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"
                                                  Visibility="{x:Bind HeatOrPlayCountText, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
