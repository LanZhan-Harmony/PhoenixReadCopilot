<?xml version="1.0" encoding="utf-8" ?>
<local:FavoritesPageControlBase x:Class="PhoenixReadCopilot.Controls.Favorites.FavoritesPageMainHeader"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:components="using:PhoenixReadCopilot.ViewModels.Components"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:ext="using:PhoenixReadCopilot.Extensions"
                                xmlns:local="using:PhoenixReadCopilot.Controls.Favorites"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="VideoTemplate" x:DataType="components:VideoFavoriteSectionDetailViewModel">
            <local:VideoFavoriteHeader ViewModel="{x:Bind}"/>
        </DataTemplate>
        <ext:FavoriteSectionTemplateSelector x:Key="Selector" VideoTempalte="{StaticResource VideoTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <ContentControl Content="{x:Bind ViewModel.CurrentSection, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource Selector}"
                        Style="{StaticResource AppContentControlStyle}"/>
    </Grid>
</local:FavoritesPageControlBase>
