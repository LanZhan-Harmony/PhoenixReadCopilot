<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Calendar.CalendarTimelineMainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:PhoenixReadCopilot.Controls.Components"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:essential="using:WinUI3Package"
             xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
             xmlns:local="using:PhoenixReadCopilot.Controls.Calendar"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:strings="using:PhoenixReadCopilot.Strings"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:CalendarVideoItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel">
            <ScrollViewer x:Name="TimelineScrollView" Style="{StaticResource PageScrollViewerStyle}">
                <ItemsRepeater x:Name="TimelineRepeater"
                               Margin="16,12"
                               ElementClearing="TimelineRepeater_ElementClearing"
                               ElementPrepared="TimelineRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource CalendarVideoItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.SelectedTimeline.Items, Mode=OneWay}"
                               Layout="{StaticResource CalendarLayout}"/>
            </ScrollViewer>
        </essential:RevealFocusPanel>

        <components:EmptyHolder Description="{x:Bind strings:Resources.TimelineHasNoVideo}"
                                Emoji="&#x1F92A;"
                                Visibility="{x:Bind ViewModel.ShowTimelineEmptyHolder, Mode=OneWay}"/>

        <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsTimelineLoading, Mode=OneWay}"/>
    </Grid>
</UserControl>
