<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary x:Class="PhoenixReadCopilot.Controls.Calendar.CalendarVideoItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:WinUIKernel.Share.Base"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                    xmlns:strings="using:PhoenixReadCopilot.Strings">

    <DataTemplate x:Key="CalendarVideoItemTemplate" x:DataType="items:VideoItemViewModel">
        <Button Command="{x:Bind PlayCommand}"
                DataContext="{x:Bind}"
                Style="{StaticResource GridRepeaterItemStyle}">
            <Button.ContextFlyout>
                <MenuFlyout ShouldConstrainToRootBounds="False">
                    <MenuFlyoutItem Command="{x:Bind OpenInNewWindowCommand}" Text="{x:Bind strings:Resources.OpenInNewWindow}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="WindowPlay"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind AddToViewLaterCommand}" Text="{x:Bind strings:Resources.AddToViewLater}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="CalendarAdd"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                    <MenuFlyoutItem Command="{x:Bind PinCommand}" Text="{x:Bind strings:Resources.FixContent}">
                        <MenuFlyoutItem.Icon>
                            <ic:SymbolIcon Symbol="Pin"/>
                        </MenuFlyoutItem.Icon>
                    </MenuFlyoutItem>
                </MenuFlyout>
            </Button.ContextFlyout>
            <Grid x:Name="TemplateContent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="90"/>
                </Grid.RowDefinitions>

                <!--  海报封面容器  -->
                <components:CoverImage x:Name="CoverImage"
                                            Grid.Row="0"
                                            Margin="6"
                                            CornerRadius="5"
                                            Source="{x:Bind Cover}"/>

                <!--  左上角：已上线状态徽章  -->
                <Border Grid.Row="0"
                        Margin="12"
                        Padding="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind IsOnline}">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                               Text="{x:Bind strings:Resources.Online}"/>
                </Border>

                <!--  左上角：未上线 / 待播说明徽章  -->
                <Border Grid.Row="0"
                        Margin="12"
                        Padding="4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Background="#B0000000"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind IsOnline, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                    <TextBlock FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="White"
                               Text="{x:Bind OnlineStatusText}"/>
                </Border>

                <!--  右下角：评分徽章  -->
                <Border Grid.Row="0"
                        Margin="12"
                        Padding="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="#B0D32F2F"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Visibility="{x:Bind HasScore}">
                    <StackPanel Orientation="Horizontal" Spacing="3">
                        <TextBlock FontWeight="Bold"
                                   Foreground="Gold"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind Score}"/>
                        <ic:SymbolIcon FontSize="{StaticResource CaptionTextBlockFontSize}"
                                       Foreground="Gold"
                                       IconVariant="Filled"
                                       Symbol="Star"/>
                    </StackPanel>
                </Border>

                <!--  信息与操作区域  -->
                <Grid Grid.Row="1"
                      Padding="10,0,10,8"
                      RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!--  标题  -->
                    <TextBlock Grid.Row="0"
                               HorizontalAlignment="Left"
                               FontWeight="SemiBold"
                               MaxLines="1"
                               Text="{x:Bind Title}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"/>

                    <!--  题材分类 / 上线说明  -->
                    <components:IconTextBlock Grid.Row="1"
                                              IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                              Symbol="Tag"
                                              Text="{x:Bind Author}"
                                              TextBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                              Visibility="{x:Bind Author, Converter={StaticResource ObjectToVisibilityConverter}}"/>

                    <!--  操作按钮区  -->
                    <Grid Grid.Row="2" VerticalAlignment="Bottom">
                        <!--  已上线：立即观看  -->
                        <Button HorizontalAlignment="Stretch"
                                Command="{x:Bind PlayCommand}"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="{x:Bind IsOnline}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ic:SymbolIcon FontSize="13"
                                               IconVariant="Filled"
                                               Symbol="Play"/>
                                <TextBlock FontSize="12" Text="{x:Bind strings:Resources.PlayNow}"/>
                            </StackPanel>
                        </Button>

                        <!--  未上线：预约控制区  -->
                        <Grid Visibility="{x:Bind IsOnline, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                            <!--  未预约状态：显示“预约”  -->
                            <Button HorizontalAlignment="Stretch"
                                    Command="{x:Bind ToggleReservationCommand}"
                                    IsEnabled="{x:Bind IsReserving, Converter={StaticResource ObjectToBoolReverseConverter}}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Visibility="{x:Bind IsReserved, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon FontSize="13" Symbol="CalendarClock"/>
                                    <TextBlock FontSize="12" Text="{x:Bind strings:Resources.Reserve}"/>
                                </StackPanel>
                            </Button>

                            <!--  已预约状态：显示“已预约”  -->
                            <Button Padding="0,3"
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ToggleReservationCommand}"
                                    IsEnabled="{x:Bind IsReserving, Converter={StaticResource ObjectToBoolReverseConverter}}"
                                    Visibility="{x:Bind IsReserved}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ic:SymbolIcon FontSize="13"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Symbol="CheckmarkCircle"/>
                                    <TextBlock FontSize="12" Text="{x:Bind strings:Resources.Reserved}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Button>
    </DataTemplate>
</ResourceDictionary>
