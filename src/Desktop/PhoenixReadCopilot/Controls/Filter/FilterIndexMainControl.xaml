<?xml version="1.0" encoding="utf-8" ?>
<local:FilterIndexControlBase x:Class="PhoenixReadCopilot.Controls.Filter.FilterIndexMainControl"
                                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:base="using:WinUIKernel.Share.Base"
                                 xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                 xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                                 xmlns:local="using:PhoenixReadCopilot.Controls.Filter"
                                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                 xmlns:strings="using:PhoenixReadCopilot.Strings"
                                 mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="SeasonScrollView" Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="16,12">
                <ItemsRepeater x:Name="SeasonRepeater"
                               ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                               Layout="{StaticResource FilterLayout}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:VideoItemViewModel">
                            <components:VideoCardControl Style="{StaticResource FilterVideoCardStyle}" ViewModel="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsSeasonLoading, Mode=OneWay}"/>
    </Grid>
</local:FilterIndexControlBase>
