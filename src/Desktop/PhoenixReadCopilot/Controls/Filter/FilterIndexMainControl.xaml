<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Filter.FilterIndexMainControl"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:essential="using:WinUI3Package"
                              xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                              xmlns:local="using:PhoenixReadCopilot.Controls.Filter"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:strings="using:PhoenixReadCopilot.Strings"
                              Loaded="OnLoaded"
                              Unloaded="OnUnloaded"
                              mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:FilterVideoItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel">
            <ScrollViewer x:Name="IndexScrollView"
                          SizeChanged="OnScrollViewSizeChanged"
                          Style="{StaticResource PageScrollViewerStyle}"
                          ViewChanged="OnViewChanged">
                <ItemsRepeater x:Name="IndexRepeater"
                               Margin="16,12"
                               ElementClearing="ItemRepeater_ElementClearing"
                               ElementPrepared="ItemRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource FilterVideoItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                               Layout="{StaticResource FilterLayout}"/>
            </ScrollViewer>
        </essential:RevealFocusPanel>
        <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsIndexLoading, Mode=OneWay}"/>
    </Grid>
</UserControl>
