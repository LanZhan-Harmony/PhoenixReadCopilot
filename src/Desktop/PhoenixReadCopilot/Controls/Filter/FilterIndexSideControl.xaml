<?xml version="1.0" encoding="utf-8" ?>
<local:FilterIndexControlBase x:Class="PhoenixReadCopilot.Controls.Filter.FilterIndexSideControl"
                                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                 xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                 xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                                 xmlns:local="using:PhoenixReadCopilot.Controls.Filter"
                                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                 mc:Ignorable="d">

    <Grid>
        <ScrollView Style="{StaticResource PageScrollViewStyle}">
            <ItemsRepeater x:Name="FilterRepeater"
                           Margin="12"
                           ItemsSource="{x:Bind ViewModel.Filters, Mode=OneWay}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="items:IndexFilterViewModel">
                        <components:IndexFilterItemControl ViewModel="{x:Bind}"/>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="8"/>
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollView>
    </Grid>
</local:FilterIndexControlBase>
