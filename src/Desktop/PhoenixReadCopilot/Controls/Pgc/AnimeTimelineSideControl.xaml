<?xml version="1.0" encoding="utf-8" ?>
<local:AnimeTimelineControlBase x:Class="PhoenixReadCopilot.Controls.Pgc.AnimeTimelineSideControl"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:animations="using:CommunityToolkit.WinUI.Animations"
                                xmlns:base="using:WinUIKernel.Share.Base"
                                xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                                xmlns:local="using:PhoenixReadCopilot.Controls.Pgc"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                xmlns:strings="using:PhoenixReadCopilot.Strings"
                                VerticalAlignment="Stretch"
                                mc:Ignorable="d">

    <Grid>
        <ItemsView x:Name="TimelineView"
                   Padding="12"
                   ItemsSource="{x:Bind ViewModel.Timelines, Mode=OneWay}"
                   SelectionMode="Single">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="items:TimelineItemViewModel">
                    <ItemContainer Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Style="{StaticResource AppItemContainerStyle}">
                        <components:TimelineControl ViewModel="{x:Bind}"/>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
            <ItemsView.Layout>
                <StackLayout Spacing="8"/>
            </ItemsView.Layout>
        </ItemsView>

        <base:EmptyHolder Description="{x:Bind strings:Resources.RequestPgcTimeLineFailed}"
                          Emoji="&#x1F6F8;"
                          Visibility="{x:Bind ViewModel.ShowSideEmptyHolder, Mode=OneWay}"/>

        <components:SideBottomLoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsTimelineLoading, Mode=OneWay}"/>

        <animations:Implicit.ShowAnimations>
            <animations:TranslationAnimation From="-20,0"
                                             To="0,0"
                                             Duration="0:0:0.24"/>
            <animations:OpacityAnimation From="0.0"
                                         To="1.0"
                                         Duration="0:0:0.2"/>
        </animations:Implicit.ShowAnimations>
        <animations:Implicit.HideAnimations>
            <animations:TranslationAnimation From="0,0"
                                             To="-20,0"
                                             Duration="0:0:0.24"/>
            <animations:OpacityAnimation From="1.0"
                                         To="0.0"
                                         Duration="0:0:0.2"/>
        </animations:Implicit.HideAnimations>
    </Grid>
</local:AnimeTimelineControlBase>
