<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PhoenixReadCopilot.Controls.Search.SearchSectionItemControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="using:PhoenixReadCopilot.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.Controls.Search"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="12,0"
            ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ic:SymbolIcon
            VerticalAlignment="Center"
            FontSize="14"
            Symbol="{x:Bind cvt:Converter.SearchSectionToSymbol(ViewModel.SectionType), Mode=OneWay}"/>
        <TextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            Text="{x:Bind cvt:Converter.SearchSectionToText(ViewModel.SectionType), Mode=OneWay}"/>
    </Grid>
</UserControl>
