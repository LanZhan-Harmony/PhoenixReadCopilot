<?xml version="1.0" encoding="utf-8" ?>
<UserControl x:Class="PhoenixReadCopilot.Controls.Search.UserSectionDetailControl"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                    xmlns:essential="using:WinUI3Package"
                                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                                    xmlns:local="using:PhoenixReadCopilot.Controls.Search"
                                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                    xmlns:strings="using:PhoenixReadCopilot.Strings"
                                    xmlns:user="using:PhoenixReadCopilot.Controls.User"
                                    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <user:UserItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel">
            <ScrollViewer x:Name="UserScrollView" Style="{StaticResource PageScrollViewerStyle}">
                <ItemsRepeater x:Name="UserRepeater"
                               Margin="16,12"
                               ElementClearing="UserRepeater_ElementClearing"
                               ElementPrepared="UserRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource UserItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                               Layout="{StaticResource UserLayout}"/>
            </ScrollViewer>
        </essential:RevealFocusPanel>

        <components:EmptyHolder Description="{x:Bind strings:Resources.NoUsers}"
                          Emoji="&#x1F937;"
                          Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"/>

        <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</UserControl>
