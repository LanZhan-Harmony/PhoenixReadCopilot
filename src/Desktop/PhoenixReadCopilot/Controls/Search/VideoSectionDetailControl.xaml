<?xml version="1.0" encoding="utf-8" ?>
<local:VideoSectionDetailControlBase x:Class="PhoenixReadCopilot.Controls.Search.VideoSectionDetailControl"
                                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                     xmlns:base="using:WinUIKernel.Share.Base"
                                     xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                                     xmlns:essential="using:WinUI3Package"
                                     xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                                     xmlns:local="using:PhoenixReadCopilot.Controls.Search"
                                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                                     xmlns:strings="using:PhoenixReadCopilot.Strings"
                                     mc:Ignorable="d">

    <local:VideoSectionDetailControlBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <local:SearchVideoItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:VideoSectionDetailControlBase.Resources>

    <Grid>
        <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel">
            <ScrollViewer x:Name="VideoScrollView" Style="{StaticResource PageScrollViewerStyle}">
                <ItemsRepeater x:Name="VideoRepeater"
                               Margin="16,12"
                               ElementClearing="VideoRepeater_ElementClearing"
                               ElementPrepared="VideoRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource SearchVideoItemTemplate}"
                               ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                               Layout="{StaticResource VideoLayout}"/>
            </ScrollViewer>
        </essential:RevealFocusPanel>

        <base:EmptyHolder Description="{x:Bind strings:Resources.NoSpecificData}"
                          Emoji="&#x1F39E;"
                          Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"/>

        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</local:VideoSectionDetailControlBase>
