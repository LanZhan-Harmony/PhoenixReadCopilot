<?xml version="1.0" encoding="utf-8" ?>
<local:AnimePageBase x:Class="PhoenixReadCopilot.Pages.AnimePage"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:base="using:WinUIKernel.Share.Base"
                     xmlns:community="using:CommunityToolkit.WinUI.Controls"
                     xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                     xmlns:components1="using:PhoenixReadCopilot.ViewModels.Components"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:extensions="using:PhoenixReadCopilot.Extensions"
                     xmlns:local="using:PhoenixReadCopilot.Pages"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:pgc="using:PhoenixReadCopilot.Controls.Pgc"
                     xmlns:strings="using:PhoenixReadCopilot.Strings"
                     mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind ViewModel.NavColumnWidth, Mode=OneWay, Converter={StaticResource GridLengthConverter}}"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.ChildrenTransitions>
            <RepositionThemeTransition IsStaggeringEnabled="False"/>
        </Grid.ChildrenTransitions>
        <Border Grid.Row="1"
                Grid.ColumnSpan="3"
                Height="1"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <pgc:AnimeSideHeader Margin="0,0,-6,0"
                             ViewModel="{x:Bind ViewModel}"
                             Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
        <pgc:AnimeTimelineSideControl Grid.Row="2"
                                      Margin="0,0,-6,0"
                                      ViewModel="{x:Bind ViewModel}"
                                      Visibility="{x:Bind ViewModel.IsNavColumnManualHide, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>

        <pgc:AnimeMainHeader Grid.Column="2"
                             Margin="-6,0,0,0"
                             VerticalAlignment="Center"
                             ViewModel="{x:Bind ViewModel}"/>
        <pgc:AnimeTimelineMainControl Grid.Row="2"
                                      Grid.Column="2"
                                      Margin="-6,0,0,0"
                                      ViewModel="{x:Bind ViewModel}"/>

        <!--  左侧分栏大小控制器  -->
        <base:ColumnSplitter Grid.RowSpan="3"
                             Grid.Column="1"
                             ColumnWidth="{x:Bind ViewModel.NavColumnWidth, Mode=TwoWay}"
                             HideTip="{x:Bind strings:Resources.Show}"
                             IsHide="{x:Bind ViewModel.IsNavColumnManualHide, Mode=TwoWay}"
                             ShowTip="{x:Bind strings:Resources.Hide}"/>
    </Grid>
</local:AnimePageBase>
