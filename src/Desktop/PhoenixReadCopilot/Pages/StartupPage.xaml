<?xml version="1.0" encoding="utf-8" ?>
<local:StartupPageBase x:Class="PhoenixReadCopilot.Pages.StartupPage"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:animations="using:CommunityToolkit.WinUI.Animations"
                       xmlns:base="using:WinUIKernel.Share.Base"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:ic="using:FluentIcons.WinUI"
                       xmlns:local="using:PhoenixReadCopilot.Pages"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:strings="using:PhoenixReadCopilot.Strings"
                       mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--  左侧：扫码登录  -->
            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        Spacing="10">
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="扫码登录"/>
                <TextBlock x:Name="TipBlock"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="请使用红果短剧 App 扫码登录"
                           TextWrapping="Wrap"/>
                <Grid x:Name="QRLoginContainer"
                      Width="190"
                      HorizontalAlignment="Center"
                      RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="190"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid CornerRadius="{StaticResource ControlCornerRadius}">
                        <Image x:Name="QRCodeImage"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               Stretch="Uniform"
                               Visibility="{x:Bind ViewModel.IsQRCodeLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}">
                            <animations:Implicit.ShowAnimations>
                                <animations:OpacityAnimation From="0.0"
                                                             To="1.0"
                                                             Duration="0:0:0.3"/>
                            </animations:Implicit.ShowAnimations>
                            <animations:Implicit.HideAnimations>
                                <animations:OpacityAnimation From="1.0"
                                                             To="0.0"
                                                             Duration="0:0:0.3"/>
                            </animations:Implicit.HideAnimations>
                        </Image>
                    </Grid>

                    <base:Shimmer x:Name="QRLoadingShimmer"
                                  Width="190"
                                  Height="190"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  CornerRadius="{StaticResource ControlCornerRadius}"
                                  IsActive="{x:Bind ViewModel.IsQRCodeLoading, Mode=OneWay}"/>

                    <HyperlinkButton x:Name="RefreshQRButton"
                                     Grid.Row="1"
                                     HorizontalAlignment="Center"
                                     Click="OnRefreshQRButtonClick"
                                     Content="{x:Bind strings:Resources.Refresh}"
                                     IsEnabled="{x:Bind ViewModel.IsQRCodeLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"/>
                </Grid>
            </StackPanel>

            <!--  分割线  -->
            <Border Grid.Column="1"
                    Width="1"
                    Margin="0,24"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

            <!--  右侧：手机验证码登录  -->
            <StackPanel Grid.Column="2"
                        Width="270"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock HorizontalAlignment="Center"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Text="短信登录"/>
                <TextBlock HorizontalAlignment="Center"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="未注册手机号验证后自动创建账号"/>

                <TextBox InputScope="TelephoneNumber"
                         MaxLength="11"
                         PlaceholderText="请输入手机号码"
                         Text="{x:Bind ViewModel.PhoneNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox InputScope="Number"
                             MaxLength="6"
                             PlaceholderText="短信验证码"
                             Text="{x:Bind ViewModel.VerificationCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Grid.Column="1"
                            Width="105"
                            Command="{x:Bind ViewModel.SendVerificationCodeCommand}"
                            Content="{x:Bind ViewModel.SendCodeButtonText, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanSendCode, Mode=OneWay}"/>
                </Grid>

                <Button Height="36"
                        Margin="0,8,0,0"
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.LoginWithSmsCommand}"
                        Content="登 录"
                        IsEnabled="{x:Bind ViewModel.IsLoggingIn, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}"
                        Style="{StaticResource AccentButtonStyle}"/>

                <TextBlock HorizontalAlignment="Center"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.ErrorTip, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.ErrorTip, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
            </StackPanel>
        </Grid>

        <!--  底部栏  -->
        <Grid Grid.Row="1"
              Padding="24,12"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
              BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="{x:Bind strings:Resources.Version}"/>
                <Run Text=":"/>
                <Run Text="{x:Bind ViewModel.Version, Mode=OneWay}"/>
            </TextBlock>
            <HyperlinkButton Grid.Column="1"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             Command="{x:Bind ViewModel.SkipLoginCommand}"
                             Content="跳过登录"/>
        </Grid>
    </Grid>
</local:StartupPageBase>
