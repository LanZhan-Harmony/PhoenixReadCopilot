<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="PhoenixReadCopilot.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:components="using:PhoenixReadCopilot.Controls.Components"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:essential="using:WinUI3Package"
      xmlns:ext="using:PhoenixReadCopilot.Extensions"
      xmlns:home="using:PhoenixReadCopilot.Controls.Home"
      xmlns:ic="using:FluentIcons.WinUI"
      xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
      xmlns:local="using:PhoenixReadCopilot.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:strings="using:PhoenixReadCopilot.Strings"
      Loaded="OnLoaded"
      Unloaded="OnUnloaded"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <home:RecommendedDramaItemTemplate/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="RecommendSectionTemplate" x:DataType="items:HomeSectionItemViewModel">
                <ItemsRepeater Margin="16,12"
                               ElementClearing="VideoRepeater_ElementClearing"
                               ElementPrepared="VideoRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource RecommendedDramaItemTemplate}"
                               ItemsSource="{x:Bind RecommendVideos, Mode=OneWay}"
                               Layout="{StaticResource VideoLayout}"/>
            </DataTemplate>

            <DataTemplate x:Key="NewArrivalSectionTemplate" x:DataType="items:HomeSectionItemViewModel">
                <ItemsRepeater Margin="16,12"
                               ElementClearing="VideoRepeater_ElementClearing"
                               ElementPrepared="VideoRepeater_ElementPrepared"
                               ItemTemplate="{StaticResource RecommendedDramaItemTemplate}"
                               ItemsSource="{x:Bind NewArrivalVideos, Mode=OneWay}"
                               Layout="{StaticResource VideoLayout}"/>
            </DataTemplate>

            <ext:HomeSectionTemplateSelector x:Key="HomeSectionSelector"
                                             NewArrivalTemplate="{StaticResource NewArrivalSectionTemplate}"
                                             RecommendTemplate="{StaticResource RecommendSectionTemplate}"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <ScrollViewer x:Name="VideoScrollView"
                      SizeChanged="OnScrollViewSizeChanged"
                      Style="{StaticResource PageScrollViewerStyle}"
                      ViewChanged="OnViewChanged">
            <StackPanel Spacing="10">
                <home:HeaderCarousel x:Name="Carousel" ItemsSource="{x:Bind ViewModel.CarouselDramas, Mode=OneWay}"/>

                <SelectorBar x:Name="CategorySelector"
                             HorizontalAlignment="Center"
                             Style="{StaticResource TokenViewSelectorBarStyle}">
                    <SelectorBarItem x:Name="RecommendSelectorItem"
                                     Style="{StaticResource TokenViewSelectorBarItemStyle}"
                                     Tag="Recommend"
                                     Text="{x:Bind strings:Resources.Recommend}">
                        <SelectorBarItem.Icon>
                            <ic:SymbolIcon IconVariant="Filled" Symbol="RibbonStar"/>
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                    <SelectorBarItem x:Name="NewArrivalSelectorItem"
                                     Style="{StaticResource TokenViewSelectorBarItemStyle}"
                                     Tag="NewArrival"
                                     Text="{x:Bind strings:Resources.NewArrival}">
                        <SelectorBarItem.Icon>
                            <ic:SymbolIcon IconVariant="Filled" Symbol="CalendarStar"/>
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <!--  推荐 / 上新短剧流  -->
                <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel">
                    <ContentControl x:Name="MainContentControl"
                                    Content="{x:Bind ViewModel.SelectedSection, Mode=OneWay}"
                                    ContentTemplateSelector="{StaticResource HomeSectionSelector}"
                                    Style="{StaticResource AppContentControlStyle}"/>
                </essential:RevealFocusPanel>
            </StackPanel>
        </ScrollViewer>

        <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}"/>
    </Grid>
</Page>
