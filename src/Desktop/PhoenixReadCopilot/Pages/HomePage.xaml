<?xml version="1.0" encoding="utf-8" ?>
<local:HomePageBase x:Class="PhoenixReadCopilot.Pages.HomePage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:essential="using:WinUI3Package"
                    xmlns:home="using:PhoenixReadCopilot.Controls.Home"
                    xmlns:local="using:PhoenixReadCopilot.Pages"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:strings="using:PhoenixReadCopilot.Strings"
                    mc:Ignorable="d">

    <local:HomePageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <home:RecommendedVideoItemTemplate/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </local:HomePageBase.Resources>

    <Grid>

        <!--  推荐短剧流  -->
        <Grid>
            <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel">
                <ScrollViewer x:Name="VideoScrollView" Style="{StaticResource PageScrollViewerStyle}">
                    <ItemsRepeater x:Name="VideoRepeater"
                                   Margin="16,12"
                                   ElementClearing="VideoRepeater_ElementClearing"
                                   ElementPrepared="VideoRepeater_ElementPrepared"
                                   ItemTemplate="{StaticResource RecommendedVideoItemTemplate}"
                                   ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                                   Layout="{StaticResource VideoLayout}"/>
                </ScrollViewer>
            </essential:RevealFocusPanel>
            <components:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}"/>
        </Grid>
    </Grid>
</local:HomePageBase>
