<?xml version="1.0" encoding="utf-8" ?>
<local:HomePageBase x:Class="PhoenixReadCopilot.Pages.HomePage"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:animations="using:PhoenixReadCopilot.Helpers.Animations"
                    xmlns:base="using:WinUIKernel.Share.Base"
                    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:essential="using:WinUI3Package"
                    xmlns:ic="using:FluentIcons.WinUI"
                    xmlns:items="using:PhoenixReadCopilot.ViewModels.Items"
                    xmlns:local="using:PhoenixReadCopilot.Pages"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:strings="using:PhoenixReadCopilot.Strings"
                    mc:Ignorable="d">

    <local:HomePageBase.Resources>
        <!--  类似 GridViewItem 的轻量卡片容器样式（保留悬浮高亮、点击反馈、焦点框，移除 CheckBox 选框）  -->
        <Style x:Key="FlatVideoGridViewItemStyle" TargetType="GridViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FocusVisualMargin" Value="-3"/>
            <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource GridViewItemFocusVisualPrimaryBrush}"/>
            <Setter Property="FocusVisualPrimaryThickness" Value="2"/>
            <Setter Property="FocusVisualSecondaryBrush" Value="{ThemeResource GridViewItemFocusVisualSecondaryBrush}"/>
            <Setter Property="FocusVisualSecondaryThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{ThemeResource ContentControlThemeFontFamily}"/>
            <Setter Property="FontSize" Value="{ThemeResource ControlContentThemeFontSize}"/>
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsHoldingEnabled" Value="True"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="TabNavigation" Value="Local"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <ListViewItemPresenter x:Name="Root"
                                               HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                               essential:RevealFocusPanel.AttachToPanel="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                               ContentMargin="{TemplateBinding Padding}"
                                               ContentTransitions="{TemplateBinding ContentTransitions}"
                                               Control.IsTemplateFocusTarget="True"
                                               CornerRadius="{TemplateBinding CornerRadius}"
                                               FocusBorderBrush="{ThemeResource GridViewItemFocusBorderBrush}"
                                               FocusVisualMargin="{TemplateBinding FocusVisualMargin}"
                                               FocusVisualPrimaryBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                               FocusVisualPrimaryThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                               FocusVisualSecondaryBrush="{TemplateBinding FocusVisualSecondaryBrush}"
                                               FocusVisualSecondaryThickness="{TemplateBinding FocusVisualSecondaryThickness}"
                                               PointerOverBackground="{ThemeResource GridViewItemBackgroundPointerOver}"
                                               PointerOverBorderBrush="{ThemeResource GridViewItemPointerOverBorderBrush}"
                                               PressedBackground="{ThemeResource GridViewItemBackgroundPressed}"
                                               SelectedBackground="Transparent"
                                               SelectedPointerOverBackground="{ThemeResource GridViewItemBackgroundPointerOver}"
                                               SelectedPressedBackground="{ThemeResource GridViewItemBackgroundPressed}"
                                               SelectionCheckMarkVisualEnabled="False">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates"
                                                  animations:FluentAnimation.PointerOver="TemplateContent"
                                                  animations:FluentAnimation.Pressed="TemplateContent">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="PointerOverPressed"/>
                                    <VisualState x:Name="Pressed"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ListViewItemPresenter>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="animations:FluentAnimation.PointerOverOffset" Value="3"/>
        </Style>

        <DataTemplate x:Key="RecommendedVideoItemTemplate" x:DataType="items:VideoItemViewModel">
            <GridViewItem Style="{StaticResource FlatVideoGridViewItemStyle}" Tapped="{x:Bind Play}">
                <Grid x:Name="TemplateContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!--  海报封面容器  -->
                    <Border Grid.Row="0"
                            Margin="6"
                            Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                            CornerRadius="5">
                        <Image HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               Stretch="UniformToFill">
                            <Image.Source>
                                <BitmapImage DecodePixelType="Logical"
                                             DecodePixelWidth="300"
                                             UriSource="{x:Bind Cover}"/>
                            </Image.Source>
                        </Image>
                    </Border>

                    <!--  左下角：集数  -->
                    <Border Grid.Row="0"
                            Margin="12"
                            Padding="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="#99000000"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind HasEpisodeCount}">
                        <TextBlock Foreground="White"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Text="{x:Bind EpisodeCountText}"/>
                    </Border>

                    <!--  右下角：评分徽章  -->
                    <Border Grid.Row="0"
                            Margin="12"
                            Padding="4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Background="#B0D32F2F"
                            CornerRadius="{StaticResource ControlCornerRadius}"
                            Visibility="{x:Bind HasScore}">
                        <StackPanel Orientation="Horizontal" Spacing="3">
                            <TextBlock FontWeight="Bold"
                                       Foreground="Gold"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Text="{x:Bind Score}"/>
                            <ic:SymbolIcon FontSize="{StaticResource CaptionTextBlockFontSize}"
                                           Foreground="Gold"
                                           IconVariant="Filled"
                                           Symbol="Star"/>
                        </StackPanel>
                    </Border>

                    <!--  信息与元数据  -->
                    <Grid Grid.Row="1"
                          Padding="10,0,10,8"
                          RowSpacing="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!--  标题  -->
                        <TextBlock Grid.Row="0"
                                   HorizontalAlignment="Left"
                                   FontWeight="SemiBold"
                                   MaxLines="2"
                                   Text="{x:Bind Title}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap"/>

                        <!--  底部行：题材分类 / 热度播放量  -->
                        <Grid Grid.Row="1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!--  标签  -->
                            <base:IconTextBlock Grid.Column="0"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                                Symbol="Tag"
                                                Text="{x:Bind Author}"
                                                Visibility="{x:Bind Author, Converter={StaticResource ObjectToVisibilityConverter}}"/>

                            <!--  热度或播放量  -->
                            <base:IconTextBlock Grid.Column="1"
                                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Symbol="PlayCircle"
                                                Text="{x:Bind HeatOrPlayCountText}"
                                                ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"
                                                Visibility="{x:Bind HeatOrPlayCountText, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </GridViewItem>
        </DataTemplate>
    </local:HomePageBase.Resources>

    <Grid>

        <!--  推荐短剧流  -->
        <Grid>
            <ScrollViewer x:Name="VideoScrollView" Style="{StaticResource PageScrollViewerStyle}">
                <essential:RevealFocusPanel x:Name="GridViewRevealFocusPanel" Margin="16,12">
                    <ItemsRepeater x:Name="VideoRepeater"
                                   ElementPrepared="VideoRepeater_ElementPrepared"
                                   ItemTemplate="{StaticResource RecommendedVideoItemTemplate}"
                                   ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                                   Layout="{StaticResource VideoLayout}"
                                   Tag="{x:Bind GridViewRevealFocusPanel}"/>
                </essential:RevealFocusPanel>
            </ScrollViewer>
            <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}"/>
        </Grid>
    </Grid>
</local:HomePageBase>
