<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="PhoenixReadCopilot.Pages.UserSpacePage"
                         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                         xmlns:components="using:PhoenixReadCopilot.Controls.Components"
                         xmlns:cvt="using:PhoenixReadCopilot.Converters"
                         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                         xmlns:local="using:PhoenixReadCopilot.Pages"
                         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                         xmlns:strings="using:PhoenixReadCopilot.Strings"
                         xmlns:user="using:PhoenixReadCopilot.Controls.User"
                         mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind cvt:Converter.DoubleToGridLength(ViewModel.NavColumnWidth), Mode=OneWay}"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--  左侧完整区域 (跨 3 行): 用户卡片 + 功能区导航  -->
        <ScrollViewer Grid.RowSpan="3" Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.IsNavColumnManualHide), Mode=OneWay}">
            <StackPanel>
                <!--  左上方: 用户介绍卡片 (名字、头像、UID、关注数、粉丝数、获赞数等)  -->
                <user:UserProfileCard ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

                <!--  左下方: 功能分类选择器 (剧作、合集、剧评、历史、收藏、点赞、预约、稍后再看等)  -->
                <user:UserSideSectionView ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
            </StackPanel>
        </ScrollViewer>

        <!--  右侧顶部 Header (高度 56px): 当前 Section 标题、子 Tab SelectorBar 与刷新操作  -->
        <user:UserMainHeader Grid.Column="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

        <!--  水平分割线 (右侧列)  -->
        <Border Grid.Row="1"
                Grid.Column="2"
                Height="1"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!--  右侧主体内容区: 呈现短剧网格、剧评流、红果圈图文/视频、关注/粉丝列表  -->
        <user:UserMainBody Grid.Row="2"
                           Grid.Column="2"
                           ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>

        <!--  左侧分栏大小控制器 (支持拖拽缩放与折叠)  -->
        <components:ColumnSplitter Grid.RowSpan="3"
                                   Grid.Column="1"
                                   ColumnWidth="{x:Bind ViewModel.NavColumnWidth, Mode=TwoWay}"
                                   HideTip="{x:Bind strings:Resources.Show}"
                                   IsHide="{x:Bind ViewModel.IsNavColumnManualHide, Mode=TwoWay}"
                                   ShowTip="{x:Bind strings:Resources.Hide}"/>
    </Grid>
</Page>
