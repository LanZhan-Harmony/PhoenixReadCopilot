<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoenixReadCopilot.Pages.Overlay.ArticlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:PhoenixReadApi"
    xmlns:comment="using:PhoenixReadCopilot.Controls.Comment"
    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
    xmlns:cvt="using:PhoenixReadCopilot.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:PhoenixReadCopilot.Strings"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition
                Width="2*"
                MinWidth="360"
                MaxWidth="520"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：沉浸式多图大画廊 (小红书风格) -->
        <Grid>
            <FlipView
                x:Name="ImageFlipView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedImageIndex, Mode=OneWay}"
                SelectionChanged="OnImageFlipViewSelectionChanged">
                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="api:CircleImage">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{x:Bind cvt:Converter.StringToBitmap(Url)}"
                                Stretch="Uniform"/>
                        </Grid>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>

            <!-- 底部轮播页码指示器 (图片大于1张时显示) -->
            <PipsPager
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                NumberOfPages="{x:Bind ViewModel.PipsPageCount, Mode=OneWay}"
                SelectedPageIndex="{x:Bind ViewModel.SelectedImageIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.ShowPipsPager, Mode=OneWay}"/>
        </Grid>

        <!-- 分割竖线 -->
        <Border
            Grid.Column="1"
            Width="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- 右侧：作者卡片、正文内容与完整评论互动区 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部作者信息 -->
            <Grid
                Padding="16,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PersonPicture
                    Width="40"
                    Height="40"
                    DisplayName="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
                    ProfilePicture="{x:Bind cvt:Converter.StringToBitmap(ViewModel.AuthorAvatarUrl), Mode=OneWay}"/>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.PublishTime, Mode=OneWay}"/>
                </StackPanel>

                <ToggleButton
                    Grid.Column="2"
                    Height="32"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ToggleFollowCommand}"
                    CornerRadius="16"
                    IsChecked="{x:Bind ViewModel.IsFollowed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:SymbolIcon
                            FontSize="12"
                            IconVariant="{x:Bind cvt:Converter.BoolToIconVariant(ViewModel.IsFollowed), Mode=OneWay}"
                            Symbol="Heart"/>
                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.FollowText, Mode=OneWay}"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- 2. 正文与关联短剧 -->
            <ScrollViewer
                Grid.Row="1"
                MaxHeight="300"
                Padding="16,12"
                Style="{StaticResource PageScrollViewerStyle}">
                <StackPanel Spacing="16">
                    <!-- 标题 -->
                    <TextBlock
                        FontWeight="Bold"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind cvt:Converter.StringToVisibility(ViewModel.Title), Mode=OneWay}"/>

                    <!-- 正文纯文本 -->
                    <TextBlock
                        FontSize="14"
                        IsTextSelectionEnabled="True"
                        LineHeight="22"
                        Text="{x:Bind ViewModel.Content, Mode=OneWay}"
                        TextWrapping="Wrap"/>

                    <!-- 关联短剧胶囊卡片 -->
                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.RelatedDramas, Mode=OneWay}"
                        Visibility="{x:Bind cvt:Converter.IntCountToVisibility(ViewModel.RelatedDramas.Count), Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="api:Drama">
                                <Border
                                    Margin="0,4"
                                    Padding="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="36"
                                            Height="48"
                                            CornerRadius="4">
                                            <Image Source="{x:Bind cvt:Converter.StringToBitmap(CoverUrl)}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Score}"/>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="OnPlayDramaButtonClick"
                                            Content="{x:Bind strings:Resources.PlayNow}"
                                            Tag="{x:Bind}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 3. 评论区：复用完整能力的 CommentMainPanel（支持最热/最新排序、点赞、楼中楼回复浮层与输入回复） -->
            <comment:CommentMainPanel
                Grid.Row="2"
                ViewModel="{x:Bind ViewModel.CommentMainViewModel, Mode=OneWay}"/>
        </Grid>

        <!-- 加载动画 -->
        <components:LoadingWidget
            Grid.ColumnSpan="3"
            Text="{x:Bind strings:Resources.LoadingAndWait}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</Page>
