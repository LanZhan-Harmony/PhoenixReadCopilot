<?xml version="1.0" encoding="utf-8" ?>
<local:ArticlePageBase
    x:Class="PhoenixReadCopilot.Pages.Overlay.ArticlePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:api="using:PhoenixReadApi"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:PhoenixReadCopilot.Strings"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="2*" MinWidth="360" MaxWidth="520"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：沉浸式多图大画廊 (小红书风格) -->
        <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
            <FlipView
                x:Name="ImageFlipView"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                ItemsSource="{x:Bind ViewModel.Images, Mode=OneWay}"
                SelectedIndex="{x:Bind ViewModel.SelectedImageIndex, Mode=TwoWay}">
                <FlipView.ItemTemplate>
                    <DataTemplate x:DataType="api:CircleImage">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Image
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="{x:Bind Url, Converter={StaticResource BitmapConverter}}"
                                Stretch="Uniform"/>
                        </Grid>
                    </DataTemplate>
                </FlipView.ItemTemplate>
            </FlipView>

            <!-- 底部轮播页码指示器 (图片大于1张时显示) -->
            <PipsPager
                Margin="0,0,0,16"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                NumberOfPages="{x:Bind ViewModel.Images.Count, Mode=OneWay}"
                SelectedPageIndex="{x:Bind ViewModel.SelectedImageIndex, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.Images.Count, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
        </Grid>

        <!-- 分割竖线 -->
        <Border
            Grid.Column="1"
            Width="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

        <!-- 右侧：作者卡片、正文内容与评论互动区 -->
        <Grid Grid.Column="2" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部作者信息 -->
            <Grid
                Padding="16,12"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <PersonPicture
                    Width="40"
                    Height="40"
                    DisplayName="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
                    ProfilePicture="{x:Bind ViewModel.AuthorAvatarUrl, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        FontWeight="SemiBold"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.AuthorName, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"/>
                    <TextBlock
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind ViewModel.PublishTime, Mode=OneWay}"/>
                </StackPanel>

                <ToggleButton
                    Grid.Column="2"
                    Height="32"
                    Padding="12,0"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ToggleFollowCommand}"
                    CornerRadius="16"
                    IsChecked="{x:Bind ViewModel.IsFollowed, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <ic:SymbolIcon
                            FontSize="12"
                            IconVariant="{x:Bind ViewModel.IsFollowed, Mode=OneWay, Converter={StaticResource BoolToIconVariantConverter}}"
                            Symbol="Heart"/>
                        <TextBlock
                            FontSize="12"
                            Text="{x:Bind ViewModel.FollowText, Mode=OneWay}"/>
                    </StackPanel>
                </ToggleButton>
            </Grid>

            <!-- 中间：正文与评论流 -->
            <ScrollViewer
                Grid.Row="1"
                Padding="16,12"
                Style="{StaticResource PageScrollViewerStyle}">
                <StackPanel Spacing="16">
                    <!-- 标题 -->
                    <TextBlock
                        FontWeight="Bold"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.Title, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>

                    <!-- 正文纯文本 -->
                    <TextBlock
                        FontSize="14"
                        IsTextSelectionEnabled="True"
                        LineHeight="22"
                        Text="{x:Bind ViewModel.Content, Mode=OneWay}"
                        TextWrapping="Wrap"/>

                    <!-- 关联短剧胶囊卡片 -->
                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.RelatedDramas, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.RelatedDramas.Count, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="api:Drama">
                                <Border
                                    Margin="0,4"
                                    Padding="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource ControlCornerRadius}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="36"
                                            Height="48"
                                            CornerRadius="4">
                                            <Image
                                                Source="{x:Bind CoverUrl, Converter={StaticResource BitmapConverter}}"
                                                Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}"
                                                TextTrimming="CharacterEllipsis"/>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{x:Bind Score}"/>
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Click="OnPlayDramaButtonClick"
                                            Content="{x:Bind strings:Resources.PlayNow}"
                                            Tag="{x:Bind Id}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 分割线 -->
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- 评论标题行 -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            FontWeight="SemiBold"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Comments}"/>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.CommentCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
                    </StackPanel>

                    <!-- 评论列表 -->
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Comments, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="api:Comment">
                                <Border
                                    Margin="0,0,0,12"
                                    Padding="0,0,0,12"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="0,0,0,1">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <PersonPicture
                                            Width="32"
                                            Height="32"
                                            VerticalAlignment="Top"
                                            DisplayName="{x:Bind Author.Name}"
                                            ProfilePicture="{x:Bind Author.AvatarUrl, Converter={StaticResource BitmapConverter}}"/>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="{x:Bind Author.Name}"/>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <ic:SymbolIcon
                                                        FontSize="10"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Symbol="ThumbLike"/>
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                        Text="{x:Bind LikeCount, Converter={StaticResource CountConverter}}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock
                                                FontSize="13"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Text}"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="{x:Bind strings:Resources.NoReply}"
                        Visibility="{x:Bind ViewModel.IsEmptyComments, Mode=OneWay}"/>
                </StackPanel>
            </ScrollViewer>

            <!-- 底部互动操作栏 -->
            <Border
                Grid.Row="2"
                Padding="16,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox
                        PlaceholderText="{x:Bind strings:Resources.DanmakuPlaceholder}"
                        Text="{x:Bind ViewModel.CommentInputText, Mode=TwoWay}"/>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Padding="8,6"
                            ToolTipService.ToolTip="{x:Bind strings:Resources.UserLikes}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <ic:SymbolIcon
                                    FontSize="12"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="Heart"/>
                                <TextBlock
                                    FontSize="12"
                                    Text="{x:Bind ViewModel.LikeCount, Mode=OneWay, Converter={StaticResource CountConverter}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 加载动画 -->
        <base:LoadingWidget
            Grid.ColumnSpan="3"
            Text="{x:Bind strings:Resources.LoadingAndWait}"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</local:ArticlePageBase>
