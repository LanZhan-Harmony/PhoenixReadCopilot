<?xml version="1.0" encoding="utf-8" ?>
<local:HistoryPageBase x:Class="PhoenixReadCopilot.Pages.Overlay.HistoryPage"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:components="using:PhoenixReadCopilot.ViewModels.Components"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:ext="using:PhoenixReadCopilot.Extensions"
                       xmlns:history="using:PhoenixReadCopilot.Controls.History"
                       xmlns:local="using:PhoenixReadCopilot.Pages.Overlay"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="VideoTemplate" x:DataType="components:VideoHistorySectionDetailViewModel">
            <history:VideoHistorySection ViewModel="{x:Bind}"/>
        </DataTemplate>

        <ext:HistorySectionTemplateSelector x:Key="TemplateSelector" VideoTemplate="{StaticResource VideoTemplate}"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <history:HistoryHeader ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
        <Border Grid.Row="1"
                Height="1"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <ContentControl Grid.Row="2"
                        Content="{x:Bind ViewModel.SelectedSection, Mode=OneWay}"
                        ContentTemplateSelector="{StaticResource TemplateSelector}"
                        Style="{StaticResource AppContentControlStyle}"
                        Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
        <history:HistoryVideoSearchSection Grid.Row="2"
                                           ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                                           Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}"/>
    </Grid>
</local:HistoryPageBase>
