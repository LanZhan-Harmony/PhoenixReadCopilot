<?xml version="1.0" encoding="utf-8" ?>
<local:UserSpacePageBase
    x:Class="PhoenixReadCopilot.Pages.Overlay.UserSpacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comment="using:PhoenixReadCopilot.Controls.Comment"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:PhoenixReadCopilot.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:moment="using:PhoenixReadCopilot.Controls.Moment"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border
            Grid.Row="1"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <moment:UserSpacePageHeader ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
        <moment:UserSpacePageBody Grid.Row="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
        <moment:UserSpaceVideoSearchSection Grid.Row="2" ViewModel="{x:Bind ViewModel, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsSearchMode, Mode=OneWay}"/>
        <comment:CommentOverlayPanel
            x:Name="CommentPanel"
            Grid.RowSpan="3"
            IsPanelOpened="{x:Bind ViewModel.IsCommentsOpened, Mode=TwoWay}"
            ViewModel="{x:Bind ViewModel.CommentModule, Mode=OneWay}"/>
    </Grid>
</local:UserSpacePageBase>
