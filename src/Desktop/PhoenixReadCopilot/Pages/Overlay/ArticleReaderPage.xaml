<?xml version="1.0" encoding="utf-8" ?>
<local:ArticleReaderPageBase
    x:Class="PhoenixReadCopilot.Pages.Overlay.ArticleReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animations="using:CommunityToolkit.WinUI.Animations"
    xmlns:article="using:PhoenixReadCopilot.Controls.Article"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:comment="using:PhoenixReadCopilot.Controls.Comment"
    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.Strings"
    xmlns:local="using:PhoenixReadCopilot.Pages.Overlay"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <article:ArticleReader
            x:Name="Reader"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>
        <article:ArticleReaderToolBar ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Margin="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityReverseConverter}}"/>
        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        <comment:CommentOverlayPanel IsPanelOpened="{x:Bind ViewModel.IsCommentsOpened, Mode=TwoWay}"
                ViewModel="{x:Bind ViewModel.CommentModule, Mode=OneWay}"/>
    </Grid>
</local:ArticleReaderPageBase>
