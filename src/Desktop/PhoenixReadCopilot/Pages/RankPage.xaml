<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="PhoenixReadCopilot.Pages.RankPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:community="using:CommunityToolkit.WinUI.Controls"
    xmlns:components="using:PhoenixReadCopilot.Controls.Components"
    xmlns:cvt="using:PhoenixReadCopilot.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.Strings"
    xmlns:local="using:PhoenixReadCopilot.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rank="using:PhoenixReadCopilot.Controls.Rank"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{x:Bind cvt:Converter.DoubleToGridLength(ViewModel.NavColumnWidth), Mode=OneWay}"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Height="1"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <rank:RankSideHeader ViewModel="{x:Bind ViewModel, Mode=OneWay}" Margin="0,0,-6,0"
                Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.IsNavColumnManualHide), Mode=OneWay}"/>
        <rank:RankSideBody ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Grid.Row="2"
            Margin="0,0,-6,0"
            Visibility="{x:Bind cvt:Converter.InvertVisibility(ViewModel.IsNavColumnManualHide), Mode=OneWay}"/>
        <rank:RankMainHeader ViewModel="{x:Bind ViewModel, Mode=OneWay}" Grid.Column="2"
                Margin="-6,0,0,0"/>
        <rank:RankMainBody ViewModel="{x:Bind ViewModel, Mode=OneWay}"
            Grid.Row="2"
            Grid.Column="2"
            Margin="-6,0,0,0"/>

        <!--  左侧分栏大小控制器  -->
        <components:ColumnSplitter
            Grid.RowSpan="3"
            Grid.Column="1"
            ColumnWidth="{x:Bind ViewModel.NavColumnWidth, Mode=TwoWay}"
            HideTip="{x:Bind strings:Resources.Show}"
            IsHide="{x:Bind ViewModel.IsNavColumnManualHide, Mode=TwoWay}"
            ShowTip="{x:Bind strings:Resources.Hide}"/>
    </Grid>
</Page>
