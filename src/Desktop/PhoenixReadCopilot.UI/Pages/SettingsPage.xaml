<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageBase x:Class="PhoenixReadCopilot.UI.Pages.SettingsPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:ic="using:FluentIcons.WinUI"
                        xmlns:local="using:PhoenixReadCopilot.UI.Pages"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:settings="using:PhoenixReadCopilot.UI.Controls.Settings"
                        xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                        mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Margin="16,0"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   Text="{x:Bind strings:Resources.Settings}"/>

        <Border Grid.Row="1"
                Height="1"
                HorizontalAlignment="Stretch"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <ScrollViewer x:Name="GenericContainer"
                      Grid.Row="2"
                      Padding="16,0"
                      Style="{StaticResource PageScrollViewerStyle}">
            <StackPanel Margin="0,12" Spacing="4">
                <StackPanel.ChildrenTransitions>
                    <RepositionThemeTransition IsStaggeringEnabled="False"/>
                </StackPanel.ChildrenTransitions>
                <TextBlock Margin="0,8,0,4"
                           HorizontalAlignment="Left"
                           Text="{x:Bind strings:Resources.Player}"/>
                <settings:PlayerControlSettingControl/>
                <settings:PlayerBehaviorSettingControl/>
                <settings:DownloadSettingControl/>
                <TextBlock Margin="0,8,0,4"
                           HorizontalAlignment="Left"
                           Text="{x:Bind strings:Resources.Generic}"/>
                <settings:ThemeSettingControl/>
                <settings:LayoutSettingSection/>
                <settings:NavigationSettingControl/>
                <settings:SearchRecommendSettingSection/>
                <settings:NotificationSettingControl/>
                <settings:LoggerSettingControl/>
                <TextBlock Margin="0,16,0,8"
                           HorizontalAlignment="Left"
                           Text="{x:Bind strings:Resources.AboutThisApp}"/>
                <settings:AboutSettingControl/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:SettingsPageBase>
