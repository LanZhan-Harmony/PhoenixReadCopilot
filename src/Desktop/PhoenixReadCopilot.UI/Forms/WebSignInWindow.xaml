<?xml version="1.0" encoding="utf-8" ?>
<base:WindowBase
    x:Class="PhoenixReadCopilot.UI.Forms.WebSignInWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:local="using:PhoenixReadCopilot.UI.Forms"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <base:AppTitleBar x:Name="TitleBar"
                Title="{x:Bind strings:Resources.AppName}">
            <base:AppTitleBar.IconElement>
                <BitmapIcon ShowAsMonochrome="False"
                        UriSource="Assets/StoreLogo.png"/>
            </base:AppTitleBar.IconElement>
        </base:AppTitleBar>
        <WebView2
            x:Name="MainView"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Loaded="OnLoadedAsync"
            NavigationCompleted="OnNavigationCompletedAsync"/>
    </Grid>
</base:WindowBase>
