<?xml version="1.0" encoding="utf-8" ?>
<winuiex:WindowEx x:Class="PhoenixReadCopilot.UI.Forms.PlayerWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="using:PhoenixReadCopilot.UI.Forms"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                  xmlns:winuiex="using:WinUIEx"
                  mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>

    <Grid PointerPressed="OnPointerPressed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TitleBar x:Name="TitleBar"
                  Title="{x:Bind strings:Resources.AppName}"
                  BackRequested="OnBackRequested"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                  BorderThickness="0,0,0,1"
                  IsBackButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/StoreLogo.png"/>
            </TitleBar.IconSource>
        </TitleBar>
        <Frame x:Name="MainFrame"
               Grid.Row="1"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Tag="PlayerWindow"/>
        <Grid x:Name="TipContainer"
              Grid.Row="1"
              Visibility="Collapsed"/>
    </Grid>
</winuiex:WindowEx>
