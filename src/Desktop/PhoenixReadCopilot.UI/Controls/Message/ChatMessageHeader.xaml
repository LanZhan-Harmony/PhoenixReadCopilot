<?xml version="1.0" encoding="utf-8" ?>
<local:ChatMessageControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.Message.ChatMessageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Message"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,0"
            ColumnSpacing="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Button
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Command="{x:Bind ViewModel.ShowUserSpaceCommand, Mode=OneWay}"
            Style="{StaticResource AvatarButtonStyle}">
            <PersonPicture
                Width="36"
                Height="36"
                DisplayName="{x:Bind ViewModel.UserName, Mode=OneWay}"
                ProfilePicture="{x:Bind ViewModel.Avatar, Mode=OneWay, Converter={StaticResource BitmapConverter}}"/>
        </Button>
        <base:TrimTextBlock
            Grid.Column="1"
            VerticalAlignment="Center"
            FontWeight="Bold"
            MaxLines="1"
            Text="{x:Bind ViewModel.UserName, Mode=OneWay}"/>

        <Button
            Grid.Column="2"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind strings:Resources.Refresh}"
            Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}">
            <StackPanel Orientation="Horizontal"
                    Spacing="8">
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Symbol="ArrowSync"/>
                <TextBlock VerticalAlignment="Center"
                        Text="{x:Bind strings:Resources.Refresh}"/>
            </StackPanel>
        </Button>
    </Grid>
</local:ChatMessageControlBase>
