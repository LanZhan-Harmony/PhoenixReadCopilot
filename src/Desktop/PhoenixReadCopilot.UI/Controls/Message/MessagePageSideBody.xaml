<?xml version="1.0" encoding="utf-8" ?>
<local:MessagePageControlBase x:Class="PhoenixReadCopilot.UI.Controls.Message.MessagePageSideBody"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:animations="using:CommunityToolkit.WinUI.Animations"
                              xmlns:base="using:Richasy.WinUIKernel.Share.Base"
                              xmlns:components="using:PhoenixReadCopilot.UI.ViewModels.Components"
                              xmlns:components1="using:PhoenixReadCopilot.UI.Controls.Components"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:ext="using:PhoenixReadCopilot.UI.Extensions"
                              xmlns:items="using:PhoenixReadCopilot.UI.ViewModels.Items"
                              xmlns:local="using:PhoenixReadCopilot.UI.Controls.Message"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                              mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="NotifyTemplate" x:DataType="components:NotifyMessageSectionDetailViewModel">
            <local:NotifyMessageSideItem ViewModel="{x:Bind}"/>
        </DataTemplate>
        <DataTemplate x:Key="ChatTemplate" x:DataType="components:ChatMessageSectionDetailViewModel">
            <local:ChatSessionSideItem ViewModel="{x:Bind}"/>
        </DataTemplate>
        <ext:MessageSectionTemplateSelector x:Key="Selector"
                                            ChatTemplate="{StaticResource ChatTemplate}"
                                            NotifyTemplate="{StaticResource NotifyTemplate}"/>
    </UserControl.Resources>

    <Grid>
        <ItemsView x:Name="SectionView"
                   Padding="2,8,8,8"
                   ItemsSource="{x:Bind ViewModel.Sections}"
                   ScrollViewer.HorizontalScrollMode="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   SelectionMode="Single">
            <ItemsView.ItemTemplate>
                <DataTemplate x:DataType="items:IMessageSectionDetailViewModel">
                    <ItemContainer MinHeight="40"
                                   Margin="8,0"
                                   Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                   Style="{StaticResource AppItemContainerStyle}">
                        <ContentControl Padding="12,0"
                                        VerticalAlignment="Center"
                                        Content="{x:Bind}"
                                        ContentTemplateSelector="{StaticResource Selector}"
                                        Style="{StaticResource AppContentControlStyle}"/>
                    </ItemContainer>
                </DataTemplate>
            </ItemsView.ItemTemplate>
            <ItemsView.Layout>
                <StackLayout Spacing="8"/>
            </ItemsView.Layout>
        </ItemsView>
        <components1:SideBottomLoadingWidget VerticalAlignment="Bottom"
                                             Text="{x:Bind strings:Resources.LoadingAndWait}"
                                             Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsChatSessionLoading, Mode=OneWay}"/>
        <animations:Implicit.ShowAnimations>
            <animations:TranslationAnimation From="-20,0"
                                             To="0,0"
                                             Duration="0:0:0.24"/>
            <animations:OpacityAnimation From="0.0"
                                         To="1.0"
                                         Duration="0:0:0.2"/>
        </animations:Implicit.ShowAnimations>
        <animations:Implicit.HideAnimations>
            <animations:TranslationAnimation From="0,0"
                                             To="-20,0"
                                             Duration="0:0:0.24"/>
            <animations:OpacityAnimation From="1.0"
                                         To="0.0"
                                         Duration="0:0:0.2"/>
        </animations:Implicit.HideAnimations>
    </Grid>
</local:MessagePageControlBase>
