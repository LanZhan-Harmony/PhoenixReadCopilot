<?xml version="1.0" encoding="utf-8" ?>
<local:VideoPartitionDetailControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.VideoPartition.VideoPartitionMainBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:components="using:PhoenixReadCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:items="using:PhoenixReadCopilot.UI.ViewModels.Items"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.VideoPartition"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer
            x:Name="VideoScrollView"
            Grid.Row="1"
            Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="16,12">
                <ItemsRepeater
                    x:Name="VideoRepeater"
                    ItemsSource="{x:Bind ViewModel.Videos, Mode=OneWay}"
                    Layout="{StaticResource VideoLayout}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:VideoItemViewModel">
                            <components:VideoCardControl Style="{StaticResource PartitionVideoCardStyle}"
                                    ViewModel="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>
        <base:LoadingWidget
            Grid.Row="1"
            Text="{x:Bind strings:Resources.LoadingAndWait}"
            Visibility="{x:Bind ViewModel.IsVideoLoading, Mode=OneWay}"/>
    </Grid>
</local:VideoPartitionDetailControlBase>
