<?xml version="1.0" encoding="utf-8" ?>
<local:VideoHistorySectionBase x:Class="PhoenixReadCopilot.UI.Controls.History.VideoHistorySection"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:base="using:WinUIKernel.Share.Base"
                               xmlns:components="using:PhoenixReadCopilot.UI.Controls.Components"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:items="using:PhoenixReadCopilot.UI.ViewModels.Items"
                               xmlns:local="using:PhoenixReadCopilot.UI.Controls.History"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                               mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="VideoScrollView" Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="16,12">
                <ItemsRepeater x:Name="VideoRepeater"
                               ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                               Layout="{StaticResource VideoLayout}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:VideoItemViewModel">
                            <components:VideoCardControl Style="{StaticResource HistoryVideoCardStyle}" ViewModel="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <base:EmptyHolder Description="{x:Bind strings:Resources.NoHistoryVideos}"
                          Emoji="&#x1F92A;"
                          Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"/>

        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</local:VideoHistorySectionBase>
