<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.Settings.LoggerSettingControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <base:SettingsExpander Description="{x:Bind strings:Resources.LoggerModuleDescription}"
            Header="{x:Bind strings:Resources.LoggerModule}">
        <Button
            x:Name="OpenLoggerFolderButton"
            MinWidth="120"
            Click="OnOpenLoggerFolderButtonClickAsync"
            Content="{x:Bind strings:Resources.OpenFolder}"/>
        <base:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="Channel"/>
        </base:SettingsExpander.HeaderIcon>
        <base:SettingsExpander.Items>
            <base:SettingsCard Header="{x:Bind strings:Resources.CleanLogger}">
                <Button
                    x:Name="CleanLoggerButton"
                    MinWidth="120"
                    Click="OnCleanLoggerButtonClickAsync"
                    Content="{x:Bind strings:Resources.Clean}"/>
            </base:SettingsCard>
        </base:SettingsExpander.Items>
    </base:SettingsExpander>
</local:SettingsPageControlBase>
