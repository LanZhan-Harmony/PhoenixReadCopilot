<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.Settings.LayoutSettingSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <base:SettingsCard Description="{x:Bind strings:Resources.TopNavVisibilityDescription}"
            Header="{x:Bind strings:Resources.TopNavVisibility}">
        <base:SettingsCard.HeaderIcon>
            <ic:SymbolIcon Symbol="LayoutColumnTwo"/>
        </base:SettingsCard.HeaderIcon>
        <ToggleSwitch IsOn="{x:Bind ViewModel.IsTopNavShown, Mode=TwoWay}"/>
    </base:SettingsCard>
</local:SettingsPageControlBase>
