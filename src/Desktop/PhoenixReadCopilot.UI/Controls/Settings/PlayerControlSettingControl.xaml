<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase x:Class="PhoenixReadCopilot.UI.Controls.Settings.PlayerControlSettingControl"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:community="using:CommunityToolkit.WinUI.Controls"
                               xmlns:constants="using:PhoenixReadCopilot.UI.Models.Constants"
                               xmlns:converters="using:PhoenixReadCopilot.UI.Converters"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:ic="using:FluentIcons.WinUI"
                               xmlns:local="using:PhoenixReadCopilot.UI.Controls.Settings"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                               mc:Ignorable="d">

    <UserControl.Resources>
        <converters:PreferCodecTypeConverter x:Key="PreferCodecConverter"/>
        <converters:MTCBehaviorConverter x:Key="MTCConverter"/>
    </UserControl.Resources>

    <community:SettingsExpander Description="{x:Bind strings:Resources.PlayerControlDescription}" Header="{x:Bind strings:Resources.PlayerControl}">
        <community:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="VideoPlayPause"/>
        </community:SettingsExpander.HeaderIcon>
        <community:SettingsExpander.Items>
            <community:SettingsCard Description="{x:Bind strings:Resources.MTCBehaviorDescription}" Header="{x:Bind strings:Resources.MTCBehavior}">
                <ComboBox MinWidth="120"
                          ItemsSource="{x:Bind ViewModel.MTCBehaviorCollection, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.MTCBehavior, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:MTCBehavior">
                            <TextBlock Text="{x:Bind Converter={StaticResource MTCConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.PreferCodecDescription}" Header="{x:Bind strings:Resources.PreferCodec}">
                <ComboBox MinWidth="120"
                          ItemsSource="{x:Bind ViewModel.PreferCodecCollection, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.PreferCodec, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="constants:PreferCodecType">
                            <TextBlock Text="{x:Bind Converter={StaticResource PreferCodecConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.SingleFastForwardAndRewindSpanDescription}" Header="{x:Bind strings:Resources.SingleFastForwardAndRewindSpan}">
                <NumberBox MinWidth="120"
                           LargeChange="50"
                           Maximum="300"
                           Minimum="3"
                           SmallChange="10"
                           SpinButtonPlacementMode="Compact"
                           Value="{x:Bind ViewModel.SingleFastForwardAndRewindSpan, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.GlobalPlaybackRateDescription}" Header="{x:Bind strings:Resources.GlobalPlaybackRate}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.GlobalPlayerSpeed, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.PlaybackRateEnhancementDescription}" Header="{x:Bind strings:Resources.PlaybackRateEnhancement}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.PlayerSpeedEnhancement, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Description="{x:Bind strings:Resources.BottomProgressVisibleDescription}" Header="{x:Bind strings:Resources.BottomProgressVisible}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.BottomProgressVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
        </community:SettingsExpander.Items>
    </community:SettingsExpander>
</local:SettingsPageControlBase>
