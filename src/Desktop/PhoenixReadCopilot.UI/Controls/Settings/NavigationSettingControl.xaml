<?xml version="1.0" encoding="utf-8" ?>
<local:SettingsPageControlBase x:Class="PhoenixReadCopilot.UI.Controls.Settings.NavigationSettingControl"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:community="using:CommunityToolkit.WinUI.Controls"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:ic="using:FluentIcons.WinUI"
                               xmlns:local="using:PhoenixReadCopilot.UI.Controls.Settings"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                               mc:Ignorable="d">

    <community:SettingsExpander Description="{x:Bind strings:Resources.SideNavigationSettingDescription}" Header="{x:Bind strings:Resources.SideNavigationSetting}">
        <community:SettingsExpander.HeaderIcon>
            <ic:SymbolIcon Symbol="Navigation"/>
        </community:SettingsExpander.HeaderIcon>
        <community:SettingsExpander.Items>
            <community:SettingsCard Header="{x:Bind strings:Resources.Popular}">
                <community:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="Rocket"/>
                </community:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsPopularNavVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.DynamicFeed}">
                <community:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="DesignIdeas"/>
                </community:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsMomentNavVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.Video}">
                <community:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="VideoClip"/>
                </community:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsVideoNavVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.Anime}">
                <community:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="Dust"/>
                </community:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsAnimeNavVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.Cinema}">
                <community:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="FilmstripPlay"/>
                </community:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsCinemaNavVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
            <community:SettingsCard Header="{x:Bind strings:Resources.Article}">
                <community:SettingsCard.HeaderIcon>
                    <ic:SymbolIcon Symbol="DocumentBulletList"/>
                </community:SettingsCard.HeaderIcon>
                <ToggleSwitch IsOn="{x:Bind ViewModel.IsArticleNavVisible, Mode=TwoWay}"/>
            </community:SettingsCard>
        </community:SettingsExpander.Items>
    </community:SettingsExpander>
</local:SettingsPageControlBase>
