<?xml version="1.0" encoding="utf-8" ?>
<local:LiveSectionDetailControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.Search.LiveSectionDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:Richasy.WinUIKernel.Share.Base"
    xmlns:components="using:PhoenixReadCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="using:PhoenixReadCopilot.UI.Extensions"
    xmlns:items="using:PhoenixReadCopilot.UI.ViewModels.Items"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Search"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="LiveScrollView"
                Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="16,12">
                <ItemsRepeater
                    x:Name="LiveRepeater"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    Layout="{StaticResource LiveLayout}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:LiveItemViewModel">
                            <components:LiveCardControl Style="{StaticResource SearchLiveCardStyle}"
                                    ViewModel="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <base:EmptyHolder
            Description="{ext:Locale Name=NoLiveRooms}"
            Emoji="&#x1F39E;"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <base:LoadingWidget Text="{ext:Locale Name=LoadingAndWait}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</local:LiveSectionDetailControlBase>
