<?xml version="1.0" encoding="utf-8" ?>
<local:UgcFavoriteControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.Favorites.UgcFavoriteHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Favorites"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal"
                Spacing="8">
            <local:UgcFavoriteSideItem
                VerticalAlignment="Center"
                FontWeight="Bold"
                ViewModel="{x:Bind ViewModel, Mode=OneWay}"/>
            <InfoBadge
                VerticalAlignment="Center"
                Style="{StaticResource InformationalValueInfoBadgeStyle}"
                Value="{x:Bind ViewModel.TotalCount, Mode=OneWay}"/>
        </StackPanel>

        <Button
            Grid.Column="2"
            VerticalAlignment="Center"
            AutomationProperties.Name="{x:Bind strings:Resources.Refresh}"
            Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource ObjectToBoolReverseConverter}}">
            <StackPanel Orientation="Horizontal"
                    Spacing="8">
                <ic:SymbolIcon
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                    Symbol="ArrowSync"/>
                <TextBlock VerticalAlignment="Center"
                        Text="{x:Bind strings:Resources.Refresh}"/>
            </StackPanel>
        </Button>
    </Grid>
</local:UgcFavoriteControlBase>
