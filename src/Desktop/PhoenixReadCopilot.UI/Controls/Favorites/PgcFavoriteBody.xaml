<?xml version="1.0" encoding="utf-8" ?>
<local:PgcFavoriteControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.Favorites.PgcFavoriteBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:components="using:PhoenixReadCopilot.UI.Controls.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:items="using:PhoenixReadCopilot.UI.ViewModels.Items"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Favorites"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <ScrollViewer x:Name="SeasonScrollView"
                Style="{StaticResource PageScrollViewerStyle}">
            <Grid Margin="16,12">
                <ItemsRepeater
                    x:Name="SeasonRepeater"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    Layout="{StaticResource PgcLayout}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="items:SeasonItemViewModel">
                            <components:SeasonCardControl Style="{StaticResource FavoriteSeasonCardStyle}"
                                    ViewModel="{x:Bind}"/>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Grid>
        </ScrollViewer>

        <base:EmptyHolder
            Description="{x:Bind strings:Resources.NoFavoritesPgc}"
            Emoji="&#x1F92A;"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <base:LoadingWidget Text="{x:Bind strings:Resources.LoadingAndWait}"
                Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}"/>
    </Grid>
</local:PgcFavoriteControlBase>
