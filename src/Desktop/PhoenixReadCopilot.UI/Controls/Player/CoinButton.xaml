<?xml version="1.0" encoding="utf-8" ?>
<base:LayoutUserControlBase
    x:Class="PhoenixReadCopilot.UI.Controls.Player.CoinButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="using:WinUIKernel.Share.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
    xmlns:ic="using:FluentIcons.WinUI"
    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Player"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <StackPanel Spacing="8">
            <ToggleButton
                x:Name="Btn"
                Width="48"
                Height="48"
                Padding="0"
                HorizontalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Checked="OnChecked"
                Click="OnCoinButtonClick"
                CornerRadius="24"
                IsChecked="{x:Bind IsCoined, Mode=OneWay}"
                IsEnabled="True"
                ToolTipService.ToolTip="{x:Bind strings:Resources.Coin}"
                Unchecked="OnUnchecked">
                <ic:SymbolIcon
                    FontSize="16"
                    IconVariant="{x:Bind IsCoined, Mode=OneWay, Converter={StaticResource BoolToIconVariantConverter}}"
                    Symbol="Blur"/>
            </ToggleButton>
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Tip, Mode=OneWay}"/>
        </StackPanel>
        <TeachingTip
            x:Name="CoinTip"
            ActionButtonClick="OnOneCoinButtonClick"
            ActionButtonContent="{x:Bind strings:Resources.OneCoin}"
            CloseButtonClick="OnTwoCoinButtonClick"
            CloseButtonContent="{x:Bind strings:Resources.TwoCoin}"
            IsLightDismissEnabled="True"
            PreferredPlacement="Top"
            ShouldConstrainToRootBounds="False"
            Subtitle="{x:Bind strings:Resources.CoinTip}"
            Target="{x:Bind Btn}">
            <TeachingTip.Content>
                <CheckBox Content="{x:Bind strings:Resources.AlsoLike}"
                        IsChecked="{x:Bind AlsoLike, Mode=TwoWay}"/>
            </TeachingTip.Content>
        </TeachingTip>
    </Grid>
</base:LayoutUserControlBase>
