<?xml version="1.0" encoding="utf-8" ?>
<local:VideoPartsSectionBase x:Class="PhoenixReadCopilot.UI.Controls.Player.VideoPartsSection"
                              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:api="using:PhoenixReadApi"
                              xmlns:base="using:WinUIKernel.Share.Base"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:local="using:PhoenixReadCopilot.UI.Controls.Player"
                              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                              xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                              mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Name="IndexTemplate" x:DataType="api:Episode">
            <ItemContainer Style="{StaticResource AppItemContainerStyle}" ToolTipService.ToolTip="{x:Bind Title}">
                <Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="{x:Bind Number}"/>
                </Grid>
            </ItemContainer>
        </DataTemplate>
        <UniformGridLayout x:Name="IndexLayout"
                           ItemsStretch="Fill"
                           MinColumnSpacing="8"
                           MinItemHeight="40"
                           MinItemWidth="42"
                           MinRowSpacing="8"/>
    </UserControl.Resources>

    <Grid Padding="12">
        <ItemsView x:Name="View"
                   ItemTemplate="{StaticResource IndexTemplate}"
                   Layout="{StaticResource IndexLayout}"
                   ItemsSource="{x:Bind ViewModel.Parts, Mode=OneWay}"
                   SelectionChanged="OnPartSelectionChanged"
                   SelectionMode="Single"/>
    </Grid>
</local:VideoPartsSectionBase>
