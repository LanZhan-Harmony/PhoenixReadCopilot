<?xml version="1.0" encoding="utf-8" ?>
<local:ArticleCardPresenter x:Class="PhoenixReadCopilot.UI.Controls.Components.HistoryArticlePresenter"
                            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:base="using:WinUIKernel.Share.Base"
                            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                            xmlns:local="using:PhoenixReadCopilot.UI.Controls.Components"
                            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                            xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                            mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="102"/>
        </Grid.RowDefinitions>
        <local:VideoCoverImage CornerRadius="4,4,0,0" Source="{x:Bind ViewModel.Cover, Mode=OneWay}"/>
        <Grid Grid.Row="1"
              Padding="12,8,12,12"
              RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock FontSize="12"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Text="{x:Bind ViewModel.Author, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Left"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Row="2"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}">
                <Run Text="{x:Bind ViewModel.CollectRelativeTime, Mode=OneWay}"/>
                <Run Text="{x:Bind strings:Resources.Read}"/>
            </TextBlock>
        </Grid>
    </Grid>
</local:ArticleCardPresenter>
