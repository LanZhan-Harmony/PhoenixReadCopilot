<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.UI.Controls.Components.RecommendVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.UI.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="102"/>
        </Grid.RowDefinitions>
        <local:VideoCoverImage CornerRadius="4,4,0,0" Source="{x:Bind ViewModel.Cover}"/>

        <Grid Grid.Row="1"
              Padding="12,8,12,12"
              RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       MaxLines="1"
                       Text="{x:Bind ViewModel.Author}"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Left"
                       Text="{x:Bind ViewModel.Title}"
                       TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid ColumnSpacing="4" Visibility="{x:Bind ViewModel.TagName, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <ic:SymbolIcon Margin="0,2,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Symbol="Tag"/>
                    <base:TrimTextBlock Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        MaxLines="1"
                                        Text="{x:Bind ViewModel.TagName}"/>
                </Grid>

                <base:IconTextBlock Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="PlayCircle"
                                    Text="{x:Bind ViewModel.PlayCount, Converter={StaticResource CountConverter}}"
                                    ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"/>
            </Grid>
        </Grid>
    </Grid>
</local:VideoCardPresenter>
