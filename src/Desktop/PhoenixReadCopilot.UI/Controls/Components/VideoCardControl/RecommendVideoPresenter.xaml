<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.UI.Controls.Components.RecommendVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.UI.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  海报封面容器  -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4,4,0,0">
            <Image HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Stretch="Uniform">
                <Image.Source>
                    <BitmapImage DecodePixelType="Logical"
                                 DecodePixelWidth="336"
                                 UriSource="{x:Bind ViewModel.Cover}"/>
                </Image.Source>
            </Image>
        </Border>

        <!--  左下角：集数  -->
        <Border Grid.Row="0"
                Margin="4"
                Padding="4"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="#99000000"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasEpisodeCount}">
            <TextBlock Foreground="White"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind ViewModel.EpisodeCountText}"/>
        </Border>

        <!--  右下角：评分徽章  -->
        <Border Grid.Row="0"
                Margin="4"
                Padding="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="#B0D32F2F"
                CornerRadius="{StaticResource ControlCornerRadius}"
                Visibility="{x:Bind ViewModel.HasScore}">
            <StackPanel Orientation="Horizontal" Spacing="3">
                <TextBlock FontWeight="Bold"
                           Foreground="Gold"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Text="{x:Bind ViewModel.Score}"/>
                <ic:SymbolIcon FontSize="{StaticResource CaptionTextBlockFontSize}"
                               Foreground="Gold"
                               IconVariant="Filled"
                               Symbol="Star"/>
            </StackPanel>
        </Border>

        <!--  信息与元数据  -->
        <StackPanel Grid.Row="1"
                    Padding="12,8,12,14"
                    Spacing="6">
            <!--  标题  -->
            <TextBlock HorizontalAlignment="Left"
                       Text="{x:Bind ViewModel.Title}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"/>

            <!--  底部行：题材分类 / 热度播放量  -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!--  分类或作者  -->
                <base:IconTextBlock Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                    Symbol="Tag"
                                    Text="{x:Bind ViewModel.Author}"
                                    Visibility="{x:Bind ViewModel.Author, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                <!--  热度或播放量  -->
                <base:IconTextBlock Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="PlayCircle"
                                    Text="{x:Bind ViewModel.HeatOrPlayCountText}"
                                    ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"
                                    Visibility="{x:Bind ViewModel.HeatOrPlayCountText, Converter={StaticResource ObjectToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </Grid>
</local:VideoCardPresenter>
