<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.UI.Controls.Components.RecommendVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.UI.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                MinHeight="112"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4,4,0,0">
            <Image HorizontalAlignment="Stretch"
                   VerticalAlignment="Top"
                   Stretch="Uniform">
                <Image.Source>
                    <BitmapImage DecodePixelType="Logical"
                                 DecodePixelWidth="336"
                                 UriSource="{x:Bind ViewModel.Cover}"/>
                </Image.Source>
            </Image>
        </Border>

        <StackPanel Grid.Row="1"
                    Padding="12,8,12,12"
                    Spacing="6">
            <TextBlock HorizontalAlignment="Left"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       MaxLines="1"
                       Text="{x:Bind ViewModel.Author}"
                       TextTrimming="CharacterEllipsis"/>

            <TextBlock HorizontalAlignment="Left"
                       Text="{x:Bind ViewModel.Title}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"/>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <base:IconTextBlock Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                    Symbol="Tag"
                                    Text="{x:Bind ViewModel.TagName}"
                                    ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"
                                    Visibility="{x:Bind ViewModel.TagName, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                <base:IconTextBlock Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="PlayCircle"
                                    Text="{x:Bind ViewModel.PlayCount, Converter={StaticResource CountConverter}}"
                                    ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}"/>
            </Grid>
        </StackPanel>
    </Grid>
</local:VideoCardPresenter>
