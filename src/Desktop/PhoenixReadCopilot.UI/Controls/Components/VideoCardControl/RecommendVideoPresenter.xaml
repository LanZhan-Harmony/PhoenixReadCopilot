<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.UI.Controls.Components.RecommendVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.UI.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--  海报封面容器  -->
        <Grid Grid.Row="0">
            <local:VideoCoverImage AspectRatio="0.75"
                                   AutoAdjustAspectRatio="True"
                                   CornerRadius="6,6,0,0"
                                   Source="{x:Bind ViewModel.Cover, Mode=OneWay}"/>

            <!--  右上角：评分徽章  -->
            <Border Margin="6"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="#E6D32F2F"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.HasScore, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" Spacing="3">
                    <ic:SymbolIcon FontSize="10"
                                   Foreground="White"
                                   Symbol="Star"/>
                    <TextBlock FontSize="11"
                               FontWeight="Bold"
                               Foreground="White"
                               Text="{x:Bind ViewModel.Score, Mode=OneWay}"/>
                </StackPanel>
            </Border>

            <!--  右下角：集数/更新状态  -->
            <Border Margin="6"
                    Padding="6,2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#B3000000"
                    CornerRadius="4"
                    Visibility="{x:Bind ViewModel.HasEpisodeCount, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock FontSize="11"
                           Foreground="White"
                           Text="{x:Bind ViewModel.EpisodeCountText, Mode=OneWay}"/>
            </Border>
        </Grid>

        <!--  信息与元数据  -->
        <StackPanel Grid.Row="1"
                    Padding="12,10,12,12"
                    Spacing="6">
            <!--  标题  -->
            <TextBlock HorizontalAlignment="Left"
                       FontWeight="SemiBold"
                       MaxLines="2"
                       Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="Wrap"/>

            <!--  标签列表  -->
            <StackPanel Orientation="Horizontal"
                        Spacing="4"
                        Visibility="{x:Bind ViewModel.HasTags, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Padding="6,1.5"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{x:Bind ViewModel.PrimaryTag, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}">
                    <TextBlock FontSize="11"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Text="{x:Bind ViewModel.PrimaryTag, Mode=OneWay}"/>
                </Border>
                <Border Padding="6,1.5"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Visibility="{x:Bind ViewModel.HasSecondaryTag, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="{x:Bind ViewModel.SecondaryTag, Mode=OneWay}"/>
                </Border>
            </StackPanel>

            <!--  底部行：题材分类 / 热度播放量  -->
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!--  分类或作者  -->
                <base:IconTextBlock Grid.Column="0"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource TextFillColorTertiaryBrush}"
                                    Symbol="FilmstripPlay"
                                    Text="{x:Bind ViewModel.Author, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.Author, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
                <!--  热度或播放量  -->
                <base:IconTextBlock Grid.Column="1"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    IconBrush="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Symbol="Fire"
                                    Text="{x:Bind ViewModel.HeatOrPlayCountText, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.HeatOrPlayCountText, Mode=OneWay, Converter={StaticResource ObjectToVisibilityConverter}}"/>
            </Grid>
        </StackPanel>
    </Grid>
</local:VideoCardPresenter>
