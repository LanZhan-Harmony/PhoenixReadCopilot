<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:base="using:WinUIKernel.Share.Base"
                    xmlns:local="using:PhoenixReadCopilot.UI.Controls.Components">

    <Style x:Key="RecommendVideoCardStyle" TargetType="local:VideoCardControl">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:VideoCardControl">
                    <base:CardControl x:Name="RootCard">
                        <local:RecommendVideoPresenter ViewModel="{TemplateBinding ViewModel}"/>
                    </base:CardControl>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

