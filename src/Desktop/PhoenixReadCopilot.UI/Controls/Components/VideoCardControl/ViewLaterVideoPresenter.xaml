<?xml version="1.0" encoding="utf-8" ?>
<local:VideoCardPresenter x:Class="PhoenixReadCopilot.UI.Controls.Components.ViewLaterVideoPresenter"
                          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:base="using:WinUIKernel.Share.Base"
                          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                          xmlns:ic="using:FluentIcons.WinUI"
                          xmlns:local="using:PhoenixReadCopilot.UI.Controls.Components"
                          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                          xmlns:strings="using:PhoenixReadCopilot.UI.Strings"
                          mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="102"/>
        </Grid.RowDefinitions>
        <local:VideoCoverImage CornerRadius="4,4,0,0" Source="{x:Bind ViewModel.Cover}"/>

        <Button x:Name="UserButton"
                Margin="6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ShowUserSpaceCommand}"
                Style="{StaticResource AvatarButtonStyle}">
            <Grid>
                <Ellipse Width="35"
                         Height="35"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Fill="Black"
                         Opacity="0.7"/>
                <PersonPicture Width="32"
                               Height="32"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               DisplayName="{x:Bind ViewModel.Author}"
                               ProfilePicture="{x:Bind ViewModel.Avatar, Converter={StaticResource BitmapConverter}}"
                               ToolTipService.ToolTip="{x:Bind ViewModel.Author}"/>
            </Grid>
        </Button>
        <Grid Grid.Row="1"
              Padding="12,8,12,12"
              RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="{x:Bind ViewModel.Author}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"/>

            <TextBlock Grid.Row="1"
                       HorizontalAlignment="Left"
                       Text="{x:Bind ViewModel.Title}"
                       TextTrimming="CharacterEllipsis"/>
            <Grid Grid.Row="2" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Style="{StaticResource CaptionTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.CollectTime}"/>
                    <Run Text="{x:Bind strings:Resources.Add}"/>
                </TextBlock>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4"
                            ToolTipService.ToolTip="{x:Bind strings:Resources.PlayCount}">
                    <ic:SymbolIcon VerticalAlignment="Center"
                                   FontSize="10"
                                   Foreground="{ThemeResource AccentTextFillColorTertiaryBrush}"
                                   Symbol="PlayCircle"/>
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Text="{x:Bind ViewModel.PlayCount, Converter={StaticResource CountConverter}}"
                               TextLineBounds="Tight"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</local:VideoCardPresenter>
